diff --git a/FEXCore/Source/Interface/Core/JIT/JITClass.h b/FEXCore/Source/Interface/Core/JIT/JITClass.h
index 17e7691..e3f9093 100644
--- a/FEXCore/Source/Interface/Core/JIT/JITClass.h
+++ b/FEXCore/Source/Interface/Core/JIT/JITClass.h
@@ -69,6 +69,32 @@ private:
   const bool HostSupportsAVX256 {};
   const bool HostSupportsRPRES {};
   const bool HostSupportsAFP {};
+  const bool HostSupportsFloatExceptions {};
+
+  // x86 RCP*/RSQRT* never raise exceptions, but their host lowering (frecpe, frsqrte, fdiv, fsqrt) traps with the
+  // guest's exception masks armed in FPCR. Bracket them: TMP1 keeps the FPCR, TMP2 is scratch.
+  void FPTrapsOff(ARMEmitter::ForwardLabel* Skip) {
+    if (!HostSupportsFloatExceptions) return;
+    mrs(TMP1, ARMEmitter::SystemRegister::FPCR);
+    // Skip the FPCR write when no trap enable is armed (IOE DZE OFE UFE IXE in bits 8-12, IDE in bit 15)
+    ubfx(ARMEmitter::Size::i64Bit, TMP2, TMP1, 8, 5);
+    ubfx(ARMEmitter::Size::i64Bit, TMP3, TMP1, 15, 1);
+    orr(ARMEmitter::Size::i64Bit, TMP2, TMP2, TMP3);
+    (void)cbz(ARMEmitter::Size::i64Bit, TMP2, Skip);
+    bic(ARMEmitter::Size::i64Bit, TMP2, TMP1, 0x1f00);
+    bic(ARMEmitter::Size::i64Bit, TMP2, TMP2, 0x8000);
+    msr(ARMEmitter::SystemRegister::FPCR, TMP2);
+    (void)Bind(Skip);
+  }
+  void FPTrapsRestore(ARMEmitter::ForwardLabel* Skip) {
+    if (!HostSupportsFloatExceptions) return;
+    ubfx(ARMEmitter::Size::i64Bit, TMP2, TMP1, 8, 5);
+    ubfx(ARMEmitter::Size::i64Bit, TMP3, TMP1, 15, 1);
+    orr(ARMEmitter::Size::i64Bit, TMP2, TMP2, TMP3);
+    (void)cbz(ARMEmitter::Size::i64Bit, TMP2, Skip);
+    msr(ARMEmitter::SystemRegister::FPCR, TMP1);
+    (void)Bind(Skip);
+  }
 
   struct RestartOptions {
     enum class Control : uint64_t {
