+DEF_OP(GetFPExceptionFlags) {
+  auto Dst = GetReg(Node);
+  // FPSR IOC(0) DZC(1) OFC(2) UFC(3) IXC(4) IDC(7) -> MXCSR IE(0) DE(1) ZE(2) OE(3) UE(4) PE(5)
+  mrs(TMP1, ARMEmitter::SystemRegister::FPSR);
+  and_(ARMEmitter::Size::i32Bit, Dst, TMP1, 1);
+  ubfx(ARMEmitter::Size::i32Bit, TMP2, TMP1, 1, 4);
+  orr(ARMEmitter::Size::i32Bit, Dst, Dst, TMP2, ARMEmitter::ShiftType::LSL, 2);
+  ubfx(ARMEmitter::Size::i32Bit, TMP2, TMP1, 7, 1);
+  orr(ARMEmitter::Size::i32Bit, Dst, Dst, TMP2, ARMEmitter::ShiftType::LSL, 1);
+}
+
 DEF_OP(SetRoundingMode) {
   auto Op = IROp->C<IR::IROp_SetRoundingMode>();
   auto Src = GetReg(Op->RoundMode);
   auto MXCSR = GetReg(Op->MXCSR);
 
+  if (Op->SetDAZ) {
+    // A full MXCSR load (LDMXCSR, FXRSTOR, XRSTOR): the six status flags live in the host FPSR cumulative bits while
+    // the JIT runs, as on ARM64EC Windows. MXCSR IE(0) DE(1) ZE(2) OE(3) UE(4) PE(5) -> FPSR IOC(0) IDC(7) DZC(1) OFC(2) UFC(3) IXC(4)
+    and_(ARMEmitter::Size::i32Bit, TMP1, MXCSR, 1);
+    ubfx(ARMEmitter::Size::i32Bit, TMP2, MXCSR, 2, 4);
+    orr(ARMEmitter::Size::i32Bit, TMP1, TMP1, TMP2, ARMEmitter::ShiftType::LSL, 1);
+    ubfx(ARMEmitter::Size::i32Bit, TMP2, MXCSR, 1, 1);
+    orr(ARMEmitter::Size::i32Bit, TMP1, TMP1, TMP2, ARMEmitter::ShiftType::LSL, 7);
+    msr(ARMEmitter::SystemRegister::FPSR, TMP1);
+  }
+
   // As above, setup the rounding flags in [31:30]
   rbit(ARMEmitter::Size::i32Bit, TMP2, Src);
   // and extract
@@ -144,6 +171,19 @@ DEF_OP(SetRoundingMode) {
     bfxil(ARMEmitter::Size::i64Bit, TMP1, MXCSR, 6, 1);
   }
 
+  if (Op->SetDAZ && HostSupportsFloatExceptions) {
+    // The six exception masks arm the FPCR trap enables, so an unmasked SSE exception traps on the host and is
+    // delivered as the guest's #XM. MXCSR IM(7) DM(8) ZM(9) OM(10) UM(11) PM(12) (1 = masked)
+    // -> FPCR IOE(8) IDE(15) DZE(9) OFE(10) UFE(11) IXE(12) (1 = trap)
+    mvn(ARMEmitter::Size::i32Bit, TMP2, MXCSR);
+    lsr(ARMEmitter::Size::i32Bit, TMP2, TMP2, 7);
+    bfi(ARMEmitter::Size::i64Bit, TMP1, TMP2, 8, 1);
+    lsr(ARMEmitter::Size::i32Bit, TMP2, TMP2, 1);
+    bfi(ARMEmitter::Size::i64Bit, TMP1, TMP2, 15, 1);
+    lsr(ARMEmitter::Size::i32Bit, TMP2, TMP2, 1);
+    bfi(ARMEmitter::Size::i64Bit, TMP1, TMP2, 9, 4);
+  }
+
   // Now save the new FPCR
   msr(ARMEmitter::SystemRegister::FPCR, TMP1);
 }
