 namespace FEX::Windows {
+// MXCSR status flag(s) implied by a floating-point exception code (overflow and underflow results are also inexact), 0 for other codes
+static inline uint32_t MXCSRFlagsForFloatException(DWORD Code) {
+  switch (static_cast<NTSTATUS>(Code)) {
+  case STATUS_FLOAT_INVALID_OPERATION: return 0x01;
+  case STATUS_FLOAT_DENORMAL_OPERAND: return 0x02;
+  case STATUS_FLOAT_DIVIDE_BY_ZERO: return 0x04;
+  case STATUS_FLOAT_OVERFLOW: return 0x08 | 0x20;
+  case STATUS_FLOAT_UNDERFLOW: return 0x10 | 0x20;
+  case STATUS_FLOAT_INEXACT_RESULT: return 0x20;
+  default: return 0;
+  }
+}
+
+// MXCSR IE(0) DE(1) ZE(2) OE(3) UE(4) PE(5) <-> FPSR IOC(0) IDC(7) DZC(1) OFC(2) UFC(3) IXC(4)
+static inline uint32_t FPSRBitsFromMXCSRFlags(uint32_t Flags) {
+  return (Flags & 1) | ((Flags >> 2) & 0xf) << 1 | ((Flags >> 1) & 1) << 7;
+}
+static inline uint32_t MXCSRFlagsFromFPSR(uint32_t FPSR) {
+  return (FPSR & 1) | ((FPSR >> 1) & 0xf) << 2 | ((FPSR >> 7) & 1) << 1;
+}
+
+// The unmasked pending x87 exception flags (bits 0-5) and the stack fault bit (bit 6) for the #MF decode
+static inline uint32_t X87PendingExceptions(const FEXCore::Core::CPUState& State) {
+  uint32_t Flags = 0;
+  for (int i = 0; i < 6; ++i) {
