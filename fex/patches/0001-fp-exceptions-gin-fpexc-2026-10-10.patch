 #include <utility>
 #include <xxhash.h>
 
+// x87 instructions that execute without checking for a pending unmasked exception (the FN* forms and FNOP);
+// every other x87 instruction and FWAIT delivers a pending #MF first
+static bool IsWaitingX87Instruction(const FEXCore::X86Tables::X86InstInfo* Info) {
+  using namespace FEXCore::X86Tables;
+  const bool InX87Table = (Info >= X87F80Ops.data() && Info < X87F80Ops.data() + X87F80Ops.size()) ||
+                          (Info >= X87F64Ops.data() && Info < X87F64Ops.data() + X87F64Ops.size());
+  if (!InX87Table || !Info->Name) {
+    return false;
+  }
+  static constexpr const char* NoWait[] = {"FNSTENV", "FNSTCW", "FNCLEX", "FNINIT", "FNSAVE", "FNSTSW", "FNOP"};
+  for (auto Name : NoWait) {
+    if (!strcmp(Info->Name, Name)) {
+      return false;
+    }
+  }
+  return true;
+}
