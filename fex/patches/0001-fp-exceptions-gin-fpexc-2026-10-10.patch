diff --git a/FEXCore/Source/Interface/Core/Interpreter/Fallbacks/F80Fallbacks.h b/FEXCore/Source/Interface/Core/Interpreter/Fallbacks/F80Fallbacks.h
index 5c0e656..67c1ded 100644
--- a/FEXCore/Source/Interface/Core/Interpreter/Fallbacks/F80Fallbacks.h
+++ b/FEXCore/Source/Interface/Core/Interpreter/Fallbacks/F80Fallbacks.h
@@ -2,6 +2,8 @@
 #pragma once
 #include "Common/SoftFloat.h"
 
+#include <cstring>
+
 #include "Interface/Core/Interpreter/Fallbacks/FallbackOpHandler.h"
 #include "Interface/IR/IR.h"
 
@@ -37,10 +39,33 @@ FEXCORE_PRESERVE_ALL_ATTR static softfloat_state SoftFloatStateFromFCW(uint16_t
 }
 
 FEXCORE_PRESERVE_ALL_ATTR static void HandleX87Exception(const softfloat_state& State, FEXCore::Core::CpuStateFrame* Frame) {
-  // Check for Invalid Operation exception (bit 0 of X87 status word)
+  // The x87 status word's sticky exception flags from the SoftFloat result (IE ZE OE UE PE; SoftFloat does not
+  // report denormal operands, so DE stays clear)
+  auto& Flags = Frame->State.flags;
   if (State.exceptionFlags & softfloat_flag_invalid) {
-    Frame->State.flags[FEXCore::X86State::X87FLAG_IE_LOC] = 1;
+    Flags[FEXCore::X86State::X87FLAG_IE_LOC] = 1;
+  }
+  if (State.exceptionFlags & softfloat_flag_infinite) {
+    Flags[FEXCore::X86State::X87FLAG_ZE_LOC] = 1;
+  }
+  if (State.exceptionFlags & softfloat_flag_overflow) {
+    Flags[FEXCore::X86State::X87FLAG_OE_LOC] = 1;
+  }
+  if (State.exceptionFlags & softfloat_flag_underflow) {
+    Flags[FEXCore::X86State::X87FLAG_UE_LOC] = 1;
   }
+  if (State.exceptionFlags & softfloat_flag_inexact) {
+    Flags[FEXCore::X86State::X87FLAG_PE_LOC] = 1;
+  }
+  // ES (mirrored by B): a flagged exception whose mask is clear is pending; it is delivered as #MF before the next
+  // waiting x87 instruction or FWAIT (X87CheckPendingException)
+  uint32_t Pending = 0;
+  for (int i = 0; i < 6; ++i) {
+    Pending |= (Flags[FEXCore::X86State::X87FLAG_IE_LOC + i] & 1) << i;
+  }
+  Pending &= ~Frame->State.FCW & 0x3f;
+  Flags[FEXCore::X86State::X87FLAG_ES_LOC] = Pending != 0;
+  Flags[FEXCore::X86State::X87FLAG_B_LOC] = Pending != 0;
 }
 
 // Wrapper for SoftFloat state to handle X87 exceptions
@@ -71,12 +96,24 @@ struct OpHandlers<IR::OP_F80CVTTO> {
   FEXCORE_PRESERVE_ALL_ATTR static VectorRegType handle4(uint16_t FCW, float src, FEXCore::Core::CpuStateFrame* Frame) {
     FEXCORE_PROFILE_INSTANT_INCREMENT(Frame->Thread, AccumulatedFloatFallbackCount, 1);
     ScopedSoftFloatState State {FCW, Frame};
+    // FLD m32fp of a denormal: the denormal-operand exception (the extended format normalises it, so SoftFloat sees nothing)
+    uint32_t Bits;
+    memcpy(&Bits, &src, sizeof(Bits));
+    if ((Bits & 0x7f800000u) == 0 && (Bits & 0x007fffffu) != 0) {
+      Frame->State.flags[FEXCore::X86State::X87FLAG_DE_LOC] = 1;
+    }
     return X80SoftFloat(&State.State, src);
   }
 
   FEXCORE_PRESERVE_ALL_ATTR static VectorRegType handle8(uint16_t FCW, double src, FEXCore::Core::CpuStateFrame* Frame) {
     FEXCORE_PROFILE_INSTANT_INCREMENT(Frame->Thread, AccumulatedFloatFallbackCount, 1);
     ScopedSoftFloatState State {FCW, Frame};
+    // FLD m64fp of a denormal: the denormal-operand exception
+    uint64_t Bits;
+    memcpy(&Bits, &src, sizeof(Bits));
+    if ((Bits & 0x7ff0000000000000ull) == 0 && (Bits & 0x000fffffffffffffull) != 0) {
+      Frame->State.flags[FEXCore::X86State::X87FLAG_DE_LOC] = 1;
+    }
     return X80SoftFloat(&State.State, src);
   }
 };
