diff --git a/FEXCore/include/FEXCore/Core/HostFeatures.h b/FEXCore/include/FEXCore/Core/HostFeatures.h
index 9708cd9..089734b 100644
--- a/FEXCore/include/FEXCore/Core/HostFeatures.h
+++ b/FEXCore/include/FEXCore/Core/HostFeatures.h
@@ -89,6 +89,9 @@ struct HostFeatures {
 
   // This affects codegen, but it isn't machine state
   HostTypeEnum HostType {};
+  // Integer DIV/IDIV raise the guest divide error (#DE) for a zero divisor or an overflowing quotient
+  // (AArch64 division never traps). Needs a frontend that maps X86State::DIVIDE_TRAP_* to its exception.
+  bool EmitDivideTraps {};
 
   // MIDR information
   // Also used for determining number of CPU cores for CPUID
diff --git a/FEXCore/include/FEXCore/Core/X86Enums.h b/FEXCore/include/FEXCore/Core/X86Enums.h
index 8c3b1c9..6c361bc 100644
--- a/FEXCore/include/FEXCore/Core/X86Enums.h
+++ b/FEXCore/include/FEXCore/Core/X86Enums.h
@@ -128,6 +128,12 @@ enum X86TrapNo : uint32_t {
   X86_TRAPNO_IRET = 32,     // IRET exception
 };
 
+// brk immediates the JIT executes for a guest divide error (#DE) when HostFeatures::EmitDivideTraps is set, at the
+// host PC of the faulting DIV/IDIV with the guest state untouched. The frontend raises its own exception for them
+// (Windows: STATUS_INTEGER_DIVIDE_BY_ZERO for a zero divisor, STATUS_INTEGER_OVERFLOW for a quotient that does not fit).
+constexpr uint16_t DIVIDE_TRAP_ZERO = 0xDE00;
+constexpr uint16_t DIVIDE_TRAP_OVERFLOW = 0xDE01;
+
 // X86 page fault error code bits
 // Populates siginfo gregs[REG_ERR]
 enum X86PageFaultBit : uint32_t {
diff --git a/Source/Windows/ARM64EC/Module.cpp b/Source/Windows/ARM64EC/Module.cpp
index d031d77..3f5e23e 100644
--- a/Source/Windows/ARM64EC/Module.cpp
+++ b/Source/Windows/ARM64EC/Module.cpp
@@ -848,6 +848,20 @@ bool ResetToConsistentStateImpl(const ThreadCPUArea CPUArea, EXCEPTION_RECORD* E
     return true;
   }
 
+  // Guest divide errors (EmitDivideTraps): the JIT stopped at a brk before the DIV/IDIV wrote anything, so the
+  // reconstructed state is the one from before the instruction, as with a real #DE. Windows reports a zero divisor
+  // as STATUS_INTEGER_DIVIDE_BY_ZERO and a quotient that does not fit as STATUS_INTEGER_OVERFLOW.
+  static constexpr uint32_t DivideZeroTrapMagic {0xD4200000 | (FEXCore::X86State::DIVIDE_TRAP_ZERO << 5)};
+  static constexpr uint32_t DivideOverflowTrapMagic {0xD4200000 | (FEXCore::X86State::DIVIDE_TRAP_OVERFLOW << 5)};
+  if (Exception->ExceptionCode == EXCEPTION_ILLEGAL_INSTRUCTION && IsJIT) {
+    const uint32_t Instr = *reinterpret_cast<uint32_t*>(NativeContext->Pc);
+    if (Instr == DivideZeroTrapMagic || Instr == DivideOverflowTrapMagic) {
+      Exception->ExceptionCode = Instr == DivideZeroTrapMagic ? EXCEPTION_INT_DIVIDE_BY_ZERO : EXCEPTION_INT_OVERFLOW;
+      Exception->ExceptionFlags = 0;
+      Exception->NumberParameters = 0;
+    }
+  }
+
   if (IsEmulatorStackAddress(CPUArea, reinterpret_cast<uint64_t>(__builtin_frame_address(0)))) {
     Exception::RethrowGuestException(*Exception, *NativeContext);
     LogMan::Msg::DFmt("Rethrowing onto guest stack: {:X}", NativeContext->Sp);
diff --git a/Source/Windows/Common/CPUFeatures.cpp b/Source/Windows/Common/CPUFeatures.cpp
index c033db8..35a70b3 100644
--- a/Source/Windows/Common/CPUFeatures.cpp
+++ b/Source/Windows/Common/CPUFeatures.cpp
@@ -85,6 +85,8 @@ FEXCore::HostFeatures CPUFeatures::FetchHostFeatures(bool IsWine, FEXCore::HostF
 
   HostFeatures.HostType = HostType;
   HostFeatures.ProcessPID = ProcessPID;
+  // The ARM64EC frontend maps the JIT's divide traps to STATUS_INTEGER_DIVIDE_BY_ZERO/OVERFLOW
+  HostFeatures.EmitDivideTraps = HostType == FEXCore::HostFeatures::HostTypeEnum::Arm64ec;
 
   if (HostType == FEXCore::HostFeatures::HostTypeEnum::Wow64) {
     // AVX is unsupported for WOW64
