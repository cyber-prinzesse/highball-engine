+bool ContextImpl::RestoreStringOpProgressFromHostPC(FEXCore::Core::InternalThreadState* Thread, uint64_t HostPC, const uint64_t* HostGPRs) {
+  // REP MOVS/STOS run as one loop over copies of RCX/RSI/RDI, which only change once it ends, so a fault part way
+  // through finds them at the first iteration. x86 reports the iteration that faulted and continues from there; a
+  // restart from the first one would redo an overlapping copy (memmove) from source bytes it already overwrote. The
+  // loop's destination pointer gives the iteration it reached: the faulting element, or the start of the faulting
+  // 32-byte block, which the continued instruction redoes (the block loops only run when |dst - src| >= 32).
+  const auto Frame = Thread->CurrentFrame;
+  auto [InlineHeader, InlineTail] = GetFrameBlockInfo(Frame);
+  const uint64_t BlockBegin = Frame->State.InlineJITBlockHeader;
+  if (!InlineHeader || HostPC < BlockBegin || HostPC >= BlockBegin + InlineTail->Size || (HostPC & 3)) {
+    return false;
+  }
+
+  const auto Access = CPU::DecodeStringLoopAccess(reinterpret_cast<const uint32_t*>(HostPC));
+  if (!Access) {
+    return false;
+  }
+
+  // The guest instruction: legacy prefixes (REP/REPNE required, no address size override), REX, then MOVS or STOS
+  auto& State = Frame->State;
+  const auto* Code = reinterpret_cast<const uint8_t*>(State.rip);
+  bool Rep = false, OpSize16 = false, RexW = false;
+  size_t i = 0;
+  for (; i < 14; ++i) {
+    const uint8_t Byte = Code[i];
+    if (Byte == 0xf2 || Byte == 0xf3) {
+      Rep = true;
+    } else if (Byte == 0x66) {
+      OpSize16 = true;
+    } else if (Byte != 0x26 && Byte != 0x2e && Byte != 0x36 && Byte != 0x3e && Byte != 0x64 && Byte != 0x65) {
+      break;
+    }
+  }
+  if ((Code[i] & 0xf0) == 0x40) {
+    RexW = Code[i] & 8;
+    ++i;
+  }
+  const uint8_t Opcode = Code[i];
+  if (!Rep || (Opcode != 0xa4 && Opcode != 0xa5 && Opcode != 0xaa && Opcode != 0xab)) {
+    return false;
+  }
+  const bool Movs = Opcode == 0xa4 || Opcode == 0xa5;
+  const uint64_t ElementSize = (Opcode & 1) ? (RexW ? 8 : OpSize16 ? 2 : 4) : 1;
+  if ((!Movs && !Access->Store) || (!Access->Block && Access->AccessSize != ElementSize)) {
+    return false;
+  }
+
+  const uint64_t Dst = HostGPRs[CPU::TMP2.Idx()];
+  const uint64_t Current = Access->Block && Access->Direction < 0 ? Dst + 32 - ElementSize : Dst;
+  auto& RCX = State.gregs[X86State::REG_RCX];
+  auto& RSI = State.gregs[X86State::REG_RSI];
+  auto& RDI = State.gregs[X86State::REG_RDI];
+  const uint64_t Done = Access->Direction > 0 ? Current - RDI : RDI - Current;
+  if (Done % ElementSize || Done / ElementSize > RCX) {
+    return false;
+  }
+
+  RCX -= Done / ElementSize;
+  RDI = Access->Direction > 0 ? RDI + Done : RDI - Done;
+  if (Movs) {
+    RSI = Access->Direction > 0 ? RSI + Done : RSI - Done;
+  }
+  return true;
+}
+
 uint32_t ContextImpl::ReconstructCompactedEFLAGS(FEXCore::Core::InternalThreadState* Thread, bool WasInJIT, const uint64_t* HostGPRs,
