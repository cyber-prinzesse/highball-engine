 namespace FEXCore::CPU {
+// One load or store of the REP MOVS/STOS loops (MemCpy and MemSet in MemoryOps.cpp), recognised by its encoding. The
+// loops work on copies of RCX/RSI/RDI: TMP2 walks the destination, TMP3 the source.
+struct StringLoopAccess {
+  bool Store;          // the store through TMP2, else the load through TMP3
+  bool Block;          // a 32-byte block of the unrolled loops (TMP2 is 32 - element size below the element when backwards)
+  int Direction;       // 1 forwards, -1 backwards
+  uint32_t AccessSize; // 32 for a block, else the element size
+};
+std::optional<StringLoopAccess> DecodeStringLoopAccess(const uint32_t* HostPC);
