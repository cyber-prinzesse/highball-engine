 }
 
+// Recognises the loads and stores MemCpy and MemSet emit for REP MOVS/STOS (keep in sync with them), so that an
+// exception or SMC fault inside the loop can resume the instruction at the iteration it reached
+// (ContextImpl::RestoreStringOpProgressFromHostPC) instead of the first one. The MOPS forms are not recognised.
+std::optional<StringLoopAccess> DecodeStringLoopAccess(const uint32_t* HostPC) {
+  const uint32_t Instr = HostPC[0];
+  const uint32_t Rn = (Instr >> 5) & 31;
+  const auto SignExtend = [](uint32_t Value, int Bits) {
+    return static_cast<int32_t>(Value << (32 - Bits)) >> (32 - Bits);
+  };
+
+  // ldp/stp q, q, [Rn], #+-32 (post-index)
+  if ((Instr >> 23) == 0x159) {
+    const bool Store = !((Instr >> 22) & 1);
+    const int32_t Offset = SignExtend((Instr >> 15) & 0x7f, 7) * 16;
+    if ((Offset == 32 || Offset == -32) && Rn == (Store ? TMP2 : TMP3).Idx()) {
+      return StringLoopAccess {Store, true, Offset > 0 ? 1 : -1, 32};
+    }
+    return std::nullopt;
+  }
+
+  // ldrb/ldrh/ldr and strb/strh/str [Rn], #+-size (post-index)
+  if ((Instr & 0x3f200c00) == 0x38000400) {
+    const uint32_t Opc = (Instr >> 22) & 3;
+    const uint32_t Size = 1U << (Instr >> 30);
+    const int32_t Offset = SignExtend((Instr >> 12) & 0x1ff, 9);
+    if (Opc <= 1 && (Offset == static_cast<int32_t>(Size) || Offset == -static_cast<int32_t>(Size)) && Rn == (Opc == 0 ? TMP2 : TMP3).Idx()) {
+      return StringLoopAccess {Opc == 0, false, Offset > 0 ? 1 : -1, Size};
+    }
+    return std::nullopt;
+  }
+
+  // The TSO element loops: ldapr*/ldar* [TMP3] or stlr* [TMP2], the pointer moves in an add/sub after the store
+  const bool LoadAcquire = (Instr & 0x3ffffc00) == 0x38bfc000 || (Instr & 0x3ffffc00) == 0x08dffc00;
+  const bool StoreRelease = (Instr & 0x3ffffc00) == 0x089ffc00;
+  if ((LoadAcquire && Rn == TMP3.Idx()) || (StoreRelease && Rn == TMP2.Idx())) {
+    const uint32_t Size = 1U << (Instr >> 30);
+    const uint32_t PtrUpdate = (Size << 10) | (TMP2.Idx() << 5) | TMP2.Idx();
+    for (int i = 1; i <= 8; ++i) {
+      if (HostPC[i] == (0x91000000 | PtrUpdate)) {
+        return StringLoopAccess {StoreRelease, false, 1, Size};
+      }
+      if (HostPC[i] == (0xd1000000 | PtrUpdate)) {
+        return StringLoopAccess {StoreRelease, false, -1, Size};
+      }
+    }
+  }
+
+  return std::nullopt;
+}
