From 6dcf01e8a87d933c99f8311a5be9bfd6bfe1424e Mon Sep 17 00:00:00 2001
From: Gauthier Piarrette <gauthierpiarrette@gmail.com>
Date: Sun, 11 Oct 2026 08:05:45 +0200
Subject: [PATCH] Keep MXCSR.DAZ in FPCR bit 19 as well

The ARM64EC context conversion keeps DAZ in FPCR bit 19 (FZ16), and ntdll's RtlCaptureContext reads the live FPCR. A full MXCSR load left that bit alone, so once a context with DAZ had been continued, every later capture reported DAZ set although the guest had cleared it. FZ16 only flushes half-precision arithmetic, not the conversions F16C uses (measured on the M1).
---
 FEXCore/Source/Interface/Core/JIT/MiscOps.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/FEXCore/Source/Interface/Core/JIT/MiscOps.cpp b/FEXCore/Source/Interface/Core/JIT/MiscOps.cpp
index f6cc340..79598f8 100644
--- a/FEXCore/Source/Interface/Core/JIT/MiscOps.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/MiscOps.cpp
@@ -171,6 +171,14 @@ DEF_OP(SetRoundingMode) {
     bfxil(ARMEmitter::Size::i64Bit, TMP1, MXCSR, 6, 1);
   }
 
+  if (Op->SetDAZ && HostSupportsFloatExceptions) {
+    // DAZ also goes to FPCR bit 19 (FZ16), where the ARM64EC context conversion keeps it (ntdll's fpcsr_to_mxcsr), so
+    // native code reading the live FPCR (RtlCaptureContext, setjmp) sees the guest's DAZ and a later context continue
+    // does not bring back an old one. FZ16 only flushes half-precision arithmetic, not the conversions F16C uses.
+    ubfx(ARMEmitter::Size::i32Bit, TMP2, MXCSR, 6, 1);
+    bfi(ARMEmitter::Size::i64Bit, TMP1, TMP2, 19, 1);
+  }
+
   if (Op->SetDAZ && HostSupportsFloatExceptions) {
     // The six exception masks arm the FPCR trap enables, so an unmasked SSE exception traps on the host and is
     // delivered as the guest's #XM. MXCSR IM(7) DM(8) ZM(9) OM(10) UM(11) PM(12) (1 = masked)
