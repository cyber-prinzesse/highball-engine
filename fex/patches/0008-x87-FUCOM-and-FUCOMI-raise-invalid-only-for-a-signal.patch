+void OpDispatchBuilder::FCOMI(OpcodeArgs, IR::OpSize Width, bool Integer, OpDispatchBuilder::FCOMIFlags WhichFlags, bool PopTwice, bool Quiet) {
   Ref arg {};
   Ref b {};
 
@@ -691,9 +691,11 @@ void OpDispatchBuilder::FCOMI(OpcodeArgs, IR::OpSize Width, bool Integer, OpDisp
     SetRFLAG<FEXCore::X86State::RFLAG_AF_RAW_LOC>(Constant(0));
   }
 
-  // Set Invalid Operation flag when unordered (NaN comparison)
-  // The x87 exception flags are sticky. Preserve earlier result
-  SetRFLAG<FEXCore::X86State::X87FLAG_IE_LOC>(_Or(OpSize::i32Bit, GetRFLAG(FEXCore::X86State::X87FLAG_IE_LOC), HostFlag_Unordered));
+  // FCOM, FCOMI and FICOM raise invalid for any NaN; the compare itself raised it already for a signalling NaN or an
+  // unsupported encoding, which is all FUCOM and FUCOMI raise it for. The x87 exception flags are sticky.
+  if (!Quiet) {
+    SetRFLAG<FEXCore::X86State::X87FLAG_IE_LOC>(_Or(OpSize::i32Bit, GetRFLAG(FEXCore::X86State::X87FLAG_IE_LOC), HostFlag_Unordered));
+  }
 
   if (PopTwice) {
     _PopStackDestroy();
