From c1a1f007c0a749737af70c755a3681589c75b045 Mon Sep 17 00:00:00 2001
From: Gauthier Piarrette <gauthierpiarrette@gmail.com>
Date: Sun, 11 Oct 2026 08:12:28 +0200
Subject: [PATCH] x87: FUCOM and FUCOMI raise invalid only for a signalling NaN

Every x87 compare set IE when the result was unordered, and the SoftFloat compare signalled invalid for any NaN, so FUCOM, FUCOMP, FUCOMPP, FUCOMI and FUCOMIP with a quiet NaN set IE, and raised #MF when the program had unmasked it. Those are the unordered compares compilers use for == and !=; only a signalling NaN or an unsupported encoding (unnormal, pseudo-NaN, pseudo-infinity) raises invalid there. FCMP now checks the operands itself and signals only for those, which is right for every compare, and FCOMI adds IE for a quiet NaN only for the FCOM, FCOMI and FICOM forms (a new Quiet argument in the opcode tables). FTST keeps its own IE.
---
 FEXCore/Source/Common/SoftFloat.h             | 29 +++++--
 .../Source/Interface/Core/OpcodeDispatcher.h  |  5 +-
 .../Interface/Core/OpcodeDispatcher/X87.cpp   | 10 ++-
 .../Core/OpcodeDispatcher/X87F64.cpp          |  4 +-
 .../Interface/Core/X86Tables/X87Tables.cpp    | 84 +++++++++----------
 5 files changed, 78 insertions(+), 54 deletions(-)

diff --git a/FEXCore/Source/Common/SoftFloat.h b/FEXCore/Source/Common/SoftFloat.h
index 0613b47..3588fcd 100644
--- a/FEXCore/Source/Common/SoftFloat.h
+++ b/FEXCore/Source/Common/SoftFloat.h
@@ -306,15 +306,34 @@ struct FEX_PACKED X80SoftFloat {
 #endif
   }
 
+  // The x87 compare: unordered when an operand is a NaN or has an unsupported encoding (an unnormal, pseudo-NaN or
+  // pseudo-infinity: a nonzero exponent without the integer bit). Only a signalling NaN or an unsupported encoding
+  // raises invalid here, as FUCOM does; FCOM, FICOM and FTST raise it for a quiet NaN too, in the opcode dispatcher.
   FEXCORE_PRESERVE_ALL_ATTR static void
   FCMP(softfloat_state* state, const X80SoftFloat& lhs, const X80SoftFloat& rhs, bool* eq, bool* lt, bool* nan) {
+    const auto Unsupported = [](const X80SoftFloat& v) {
+      return v.Top.Exponent != 0 && !(v.Significand & 0x8000'0000'0000'0000ULL);
+    };
+    const auto IsNaN = [](const X80SoftFloat& v) {
+      return v.Top.Exponent == 0x7FFF && (v.Significand & 0x7FFF'FFFF'FFFF'FFFFULL) != 0;
+    };
+    const auto Signalling = [&](const X80SoftFloat& v) {
+      return Unsupported(v) || (IsNaN(v) && !(v.Significand & 0x4000'0000'0000'0000ULL));
+    };
+
+    if (Unsupported(lhs) || Unsupported(rhs) || IsNaN(lhs) || IsNaN(rhs)) {
+      if (Signalling(lhs) || Signalling(rhs)) {
+        softfloat_raiseFlags(state, softfloat_flag_invalid);
+      }
+      *eq = false;
+      *lt = false;
+      *nan = true;
+      return;
+    }
+
     *eq = extF80_eq(state, lhs, rhs);
     *lt = extF80_lt(state, lhs, rhs);
-
-    // Use IEEE 754 semantics: unordered if neither <, =, nor > is true
-    // This is more reliable than custom NaN detection
-    bool gt = !(*eq) && !(*lt) && extF80_le(state, rhs, lhs);
-    *nan = !(*eq) && !(*lt) && !gt;
+    *nan = false;
   }
 
   FEXCORE_PRESERVE_ALL_ATTR static X80SoftFloat FSCALE(softfloat_state* state, const X80SoftFloat& lhs, const X80SoftFloat& rhs) {
