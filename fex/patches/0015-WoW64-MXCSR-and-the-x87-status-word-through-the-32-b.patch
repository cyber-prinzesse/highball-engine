diff --git a/Source/Windows/Common/Exception.h b/Source/Windows/Common/Exception.h
index 8821d09..c913d8b 100644
--- a/Source/Windows/Common/Exception.h
+++ b/Source/Windows/Common/Exception.h
@@ -30,6 +30,33 @@ static inline uint32_t MXCSRFlagsFromFPSR(uint32_t FPSR) {
   return (FPSR & 1) | ((FPSR >> 1) & 0xf) << 2 | ((FPSR >> 7) & 1) << 1;
 }
 
+// The x87 status word from FEX's flags (IE DE ZE OE UE PE SF, ES with B mirroring it, C0-C3, TOP), and back
+static inline uint16_t X87StatusWord(const FEXCore::Core::CPUState& State) {
+  using namespace FEXCore::X86State;
+  uint16_t Value = (State.flags[X87FLAG_TOP_LOC] & 7) << 11;
+  Value |= (State.flags[X87FLAG_C0_LOC] & 1) << 8 | (State.flags[X87FLAG_C1_LOC] & 1) << 9 | (State.flags[X87FLAG_C2_LOC] & 1) << 10 |
+           (State.flags[X87FLAG_C3_LOC] & 1) << 14;
+  for (int i = 0; i < 7; ++i) {
+    Value |= (State.flags[X87FLAG_IE_LOC + i] & 1) << i;
+  }
+  Value |= (State.flags[X87FLAG_ES_LOC] & 1) << 7 | (State.flags[X87FLAG_ES_LOC] & 1) << 15;
+  return Value;
+}
+
+static inline void SetX87StatusWord(FEXCore::Core::CPUState& State, uint16_t Value) {
+  using namespace FEXCore::X86State;
+  for (int i = 0; i < 7; ++i) {
+    State.flags[X87FLAG_IE_LOC + i] = (Value >> i) & 1;
+  }
+  State.flags[X87FLAG_ES_LOC] = (Value >> 7) & 1;
+  State.flags[X87FLAG_B_LOC] = (Value >> 7) & 1;
+  State.flags[X87FLAG_C0_LOC] = (Value >> 8) & 1;
+  State.flags[X87FLAG_C1_LOC] = (Value >> 9) & 1;
+  State.flags[X87FLAG_C2_LOC] = (Value >> 10) & 1;
+  State.flags[X87FLAG_C3_LOC] = (Value >> 14) & 1;
+  State.flags[X87FLAG_TOP_LOC] = (Value >> 11) & 0b111;
+}
+
 // The unmasked pending x87 exception flags (bits 0-5) and the stack fault bit (bit 6) for the #MF decode
 static inline uint32_t X87PendingExceptions(const FEXCore::Core::CPUState& State) {
   uint32_t Flags = 0;
diff --git a/Source/Windows/WOW64/Module.cpp b/Source/Windows/WOW64/Module.cpp
index 45541b8..e1934fd 100644
--- a/Source/Windows/WOW64/Module.cpp
+++ b/Source/Windows/WOW64/Module.cpp
@@ -239,16 +239,21 @@ void LoadStateFromWowContext(FEXCore::Core::InternalThreadState* Thread) {
   memcpy(State.mm, XSave->FloatRegisters, sizeof(State.mm));
 
   State.FCW = XSave->ControlWord;
-  State.flags[FEXCore::X86State::X87FLAG_IE_LOC] = XSave->StatusWord & 1;
-  State.flags[FEXCore::X86State::X87FLAG_C0_LOC] = (XSave->StatusWord >> 8) & 1;
-  State.flags[FEXCore::X86State::X87FLAG_C1_LOC] = (XSave->StatusWord >> 9) & 1;
-  State.flags[FEXCore::X86State::X87FLAG_C2_LOC] = (XSave->StatusWord >> 10) & 1;
-  State.flags[FEXCore::X86State::X87FLAG_C3_LOC] = (XSave->StatusWord >> 14) & 1;
-  State.flags[FEXCore::X86State::X87FLAG_TOP_LOC] = (XSave->StatusWord >> 11) & 0b111;
+  FEX::Windows::SetX87StatusWord(State, XSave->StatusWord);
   State.AbridgedFTW = XSave->TagWord;
+
+  // MXCSR: the JIT keeps the control bits in the state and arms the trap enables from them; the status flags are
+  // the FPSR cumulative bits while it runs. Native code ran since the context was stored (a system call, an exception
+  // handler that may have changed MXCSR), so both come from the context.
+  State.mxcsr = XSave->MxCsr & 0xFFC0;
+  uint64_t FPSR;
+  __asm volatile("mrs %[fpsr], fpsr" : [fpsr] "=r"(FPSR));
+  FPSR = (FPSR & ~0x9fULL) | FEX::Windows::FPSRBitsFromMXCSRFlags(XSave->MxCsr & 0x3f);
+  __asm volatile("msr fpsr, %[fpsr]" ::[fpsr] "r"(FPSR));
 }
 
-void StoreWowContextFromState(WOW64_CONTEXT* Context) {
+// FPSR: the host FPSR holding the guest's MXCSR status flags (the faulting context's for an exception)
+void StoreWowContextFromState(WOW64_CONTEXT* Context, uint64_t FPSR) {
   auto Thread = GetTLS().ThreadState();
   auto& State = Thread->CurrentFrame->State;
 
@@ -281,10 +286,10 @@ void StoreWowContextFromState(WOW64_CONTEXT* Context) {
   memcpy(XSave->FloatRegisters, State.mm, sizeof(State.mm));
 
   XSave->ControlWord = State.FCW;
-  XSave->StatusWord = (State.flags[FEXCore::X86State::X87FLAG_TOP_LOC] << 11) | (State.flags[FEXCore::X86State::X87FLAG_C0_LOC] << 8) |
-                      (State.flags[FEXCore::X86State::X87FLAG_C1_LOC] << 9) | (State.flags[FEXCore::X86State::X87FLAG_C2_LOC] << 10) |
-                      (State.flags[FEXCore::X86State::X87FLAG_C3_LOC] << 14) | State.flags[FEXCore::X86State::X87FLAG_IE_LOC];
+  XSave->StatusWord = FEX::Windows::X87StatusWord(State);
   XSave->TagWord = State.AbridgedFTW;
+  XSave->MxCsr = (State.mxcsr & 0xFFC0) | FEX::Windows::MXCSRFlagsFromFPSR(static_cast<uint32_t>(FPSR));
+  XSave->MxCsr_Mask = 0xFFFF;
 
   Context->FloatSave.ControlWord = XSave->ControlWord;
   Context->FloatSave.StatusWord = XSave->StatusWord;
@@ -297,7 +302,9 @@ void StoreWowContextFromState(WOW64_CONTEXT* Context) {
 }
 
 void FlushThreadStateContext() {
-  StoreWowContextFromState(GetWow64Context());
+  uint64_t FPSR;
+  __asm volatile("mrs %[fpsr], fpsr" : [fpsr] "=r"(FPSR));
+  StoreWowContextFromState(GetWow64Context(), FPSR);
 }
 
 void ReconstructThreadState(CONTEXT* Context) {
@@ -331,11 +338,7 @@ WOW64_CONTEXT* ReconstructWowContext(CONTEXT* Context) {
   }
 
   WOW64_CONTEXT* WowContext = GetWow64Context();
-  auto* XSave = reinterpret_cast<XSAVE_FORMAT*>(WowContext->ExtendedRegisters);
-  XSave->ControlWord = 0x27f;
-  XSave->MxCsr = 0x1f80;
-
-  StoreWowContextFromState(WowContext);
+  StoreWowContextFromState(WowContext, Context->Fpsr);
   return WowContext;
 }
 
@@ -379,12 +382,17 @@ bool HandleSuspendInterrupt(CONTEXT* Context) {
 
   // Since interrupts only happen at the start of blocks, the reconstructed state should be entirely accurate
   ReconstructThreadState(Context);
-  FlushThreadStateContext();
+  StoreWowContextFromState(GetWow64Context(), Context->Fpsr);
 
   // Yield to the suspender
   UnlockJITContext();
   LockJITContext();
 
+  // The context may have been changed meanwhile (SetThreadContext): continue with the MXCSR flags it holds now
+  uint64_t FPSR;
+  __asm volatile("mrs %[fpsr], fpsr" : [fpsr] "=r"(FPSR));
+  Context->Fpsr = static_cast<DWORD>(FPSR);
+
   // Adjust context to return to the dispatcher, reloading SRA from thread state
   const auto& Config = SignalDelegator->GetConfig();
   Context->Pc = Config.AbsoluteLoopTopAddressFillSRA;
@@ -793,6 +801,7 @@ bool BTCpuResetToConsistentStateImpl(EXCEPTION_POINTERS* Ptrs) {
   LogMan::Msg::DFmt("pc: {:X} eip: {:X} code: {:X}", Context->Pc, WowContext->Eip, Exception->ExceptionCode);
 
   auto& Fault = Thread->CurrentFrame->SynchronousFaultData;
+  const bool HostFault = !Fault.FaultToTopAndGeneratedException;
   BOOL FirstChance = TRUE;
   EXCEPTION_RECORD GuestException =
     FEX::Windows::HandleGuestException(Fault, *Exception, WowContext->Eip, WowContext->Eax, WowContext->Ecx, FirstChance,
@@ -800,6 +809,14 @@ bool BTCpuResetToConsistentStateImpl(EXCEPTION_POINTERS* Ptrs) {
   if (GuestException.ExceptionCode == EXCEPTION_SINGLE_STEP) {
     WowContext->EFlags &= ~(1 << FEXCore::X86State::RFLAG_TF_RAW_LOC);
   }
+  if (const uint32_t Flags = HostFault ? FEX::Windows::MXCSRFlagsForFloatException(GuestException.ExceptionCode) : 0) {
+    // An unmasked SSE exception trapped on the host (the trap enables follow the guest's MXCSR masks in JIT code). x86
+    // sets the flag in MXCSR, and 32-bit Windows reports every SIMD floating-point exception as
+    // STATUS_FLOAT_MULTIPLE_TRAPS (measured on Windows Server 2022 and 2025; x64 programs get the specific code).
+    reinterpret_cast<XSAVE_FORMAT*>(WowContext->ExtendedRegisters)->MxCsr |= Flags;
+    GuestException.ExceptionCode = STATUS_FLOAT_MULTIPLE_TRAPS;
+    GuestException.NumberParameters = 0;
+  }
   // wow64.dll will handle adjusting PC in the dispatched context after a breakpoint
 
   Context::UnlockJITContext();
