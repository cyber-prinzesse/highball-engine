+// Data breakpoints (X86State::DebugBreakpoints::Watches): an access that overlaps a watched range sets the
+// breakpoint's DR6 bit and CpuStateFrame::DebugWatchHit. A thread with data breakpoints runs one instruction per
+// block, so the check at the next block start raises the trap right after the instruction, as x86 does. Emitted before
+// the access, with the thread's ranges as constants: the thread's code is recompiled when they change. Uses TMP3 and
+// TMP4 only, before the op's own code, and leaves NZCV alone (it holds the guest's flags between ops): the range tests
+// are sign tests of differences, exact for user-space addresses (below 2^62).
+void Arm64JITCore::EmitDebugWatchHit(uint8_t Bit) {
+  ldr(TMP4, STATE_PTR(CpuStateFrame, State.dr6));
+  orr(ARMEmitter::Size::i64Bit, TMP4, TMP4, 1ULL << Bit);
+  str(TMP4, STATE_PTR(CpuStateFrame, State.dr6));
+  LoadConstant(ARMEmitter::Size::i32Bit, TMP4, 1);
+  strb(TMP4.W(), STATE_PTR(CpuStateFrame, DebugWatchHit));
+}
+
+void Arm64JITCore::EmitDebugWatchCheck(ARMEmitter::Register Address, uint64_t Size, bool IsStore) {
+  const auto& Breakpoints = ThreadState->DebugBreakpoints;
+  for (uint32_t i = 0; i < Breakpoints.NumWatch; ++i) {
+    const auto& Watch = Breakpoints.Watches[i];
+    if (Watch.WriteOnly && !IsStore) {
+      continue;
+    }
+    ARMEmitter::ForwardLabel Miss;
+    // [Address, Address + Size) overlaps [Start, Start + Length) when Start - Size < Address < Start + Length
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP4, Watch.Start + Watch.Length);
+    sub(ARMEmitter::Size::i64Bit, TMP4, Address, TMP4);
+    (void)tbz(TMP4, 63, &Miss); // Address >= Start + Length
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP4, Watch.Start - Size);
+    sub(ARMEmitter::Size::i64Bit, TMP4, TMP4, Address);
+    (void)tbz(TMP4, 63, &Miss); // Address <= Start - Size
+    EmitDebugWatchHit(Watch.Bit);
+    (void)Bind(&Miss);
+  }
+}
+
+void Arm64JITCore::EmitDebugWatchCheckMem(IR::OpSize AccessSize, ARMEmitter::Register Base, IR::OrderedNodeWrapper Offset,
+                                          IR::MemOffsetType OffsetType, uint8_t OffsetScale, uint64_t Size, bool IsStore) {
+  EmitDebugWatchCheck(ApplyMemOperand(AccessSize, Base, TMP3, Offset, OffsetType, OffsetScale), Size, IsStore);
+}
+
+void Arm64JITCore::EmitDebugWatchCheckImm(ARMEmitter::Register Base, int64_t Offset, uint64_t Size, bool IsStore) {
+  if (Offset == 0) {
+    EmitDebugWatchCheck(Base, Size, IsStore);
+    return;
+  }
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP3, static_cast<uint64_t>(Offset));
+  add(ARMEmitter::Size::i64Bit, TMP3, Base, TMP3);
+  EmitDebugWatchCheck(TMP3, Size, IsStore);
+}
+
+// A string instruction's whole range: Length elements of ElementSize from Start, forwards or backwards (Direction is
+// the +1/-1 of the DF flag, inline or in a register). The trap follows the instruction, not the matching element.
+void Arm64JITCore::EmitDebugWatchCheckRange(ARMEmitter::Register Start, ARMEmitter::Register Length, uint64_t ElementSize,
+                                            IR::OrderedNodeWrapper Direction, bool IsStore) {
+  const auto& Breakpoints = ThreadState->DebugBreakpoints;
+  bool Any = false;
+  for (uint32_t i = 0; i < Breakpoints.NumWatch; ++i) {
+    Any |= !(Breakpoints.Watches[i].WriteOnly && !IsStore);
+  }
+  if (!Any) {
+    return;
+  }
+
+  ARMEmitter::ForwardLabel Done, Backward, Compare;
+  (void)cbz(ARMEmitter::Size::i64Bit, Length, &Done);
+  // TMP3 = bytes, then TMP1 = first byte, TMP2 = one past the last
+  lsl(ARMEmitter::Size::i64Bit, TMP3, Length, FEXCore::ilog2(ElementSize));
+  uint64_t DirectionConstant {};
+  const bool DirectionIsInline = IsInlineConstant(Direction, &DirectionConstant);
+  const bool ConstantBackward = DirectionIsInline && static_cast<int64_t>(DirectionConstant) < 0;
+  if (!DirectionIsInline) {
+    (void)tbnz(GetReg(Direction), 1, &Backward);
+  }
+  if (!ConstantBackward) {
+    mov(ARMEmitter::Size::i64Bit, TMP1, Start);
+    add(ARMEmitter::Size::i64Bit, TMP2, Start, TMP3);
+    if (!DirectionIsInline) {
+      (void)b(&Compare);
+    }
+  }
+  if (!DirectionIsInline || ConstantBackward) {
+    (void)Bind(&Backward);
+    add(ARMEmitter::Size::i64Bit, TMP2, Start, ElementSize);
+    sub(ARMEmitter::Size::i64Bit, TMP1, TMP2, TMP3);
+  }
+  (void)Bind(&Compare);
+  for (uint32_t i = 0; i < Breakpoints.NumWatch; ++i) {
+    const auto& Watch = Breakpoints.Watches[i];
+    if (Watch.WriteOnly && !IsStore) {
+      continue;
+    }
+    ARMEmitter::ForwardLabel Miss;
