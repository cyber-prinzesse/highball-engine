diff --git a/FEXCore/include/FEXCore/Core/DebugRegisters.h b/FEXCore/include/FEXCore/Core/DebugRegisters.h
new file mode 100644
index 0000000..b6909d6
--- /dev/null
+++ b/FEXCore/include/FEXCore/Core/DebugRegisters.h
@@ -0,0 +1,154 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <cstdint>
+
+namespace FEXCore::X86State {
+// The x86 hardware debug registers (Intel SDM vol. 3 ch. 18). DR0-DR3 hold linear addresses; DR7 enables each one
+// (L and G bits, bits 0-7, the same thing for a user-mode program) and says what it watches: R/W field 0 is an
+// instruction breakpoint, 1 a write, 3 a read or write, 2 port I/O (never, it needs CR4.DE), LEN field 0, 1, 3, 2
+// for 1, 2, 4, 8 bytes aligned to that length. DR6 reports the breakpoints whose condition was met (B0-B3) and a
+// single step (BS); it is sticky, software clears it.
+constexpr uint64_t DR6_BREAKPOINT_MASK = 0xf;
+constexpr uint64_t DR6_BS = 1ULL << 14;
+constexpr uint64_t DR6_READ_AS_ONE = 0xffff0ff0; // bits 4-11 and 16-31 read as 1 (RTM clear), as Windows reports them
+// What Windows keeps of DR7, measured on Windows Server 2022 and 2025: the local enables L0-L3, LE, GE and the R/W and
+// LEN fields for a 64-bit program; a 32-bit one (WoW64) loses GE too. The global enables are dropped (a breakpoint
+// enabled with G0 never fires). The kernel keeps the registers of a thread only while DR7 has one of L0-L3, LE or GE
+// set, and reads DR7 back with bit 10 set then.
+constexpr uint64_t DR7_LEGAL_MASK = 0xffff0355;
+constexpr uint64_t DR7_LEGAL_MASK_WOW64 = 0xffff0155;
+constexpr uint64_t DR7_ACTIVE_MASK = 0x355;
+constexpr uint64_t DR7_LE = 0x100;
+constexpr uint64_t DR7_READ_AS_ONE = 1ULL << 10;
+
+// The debug registers as a Windows context reports them: all 0 unless DR7 keeps them (DR7_ACTIVE_MASK); otherwise
+// DR7 with bit 10 set and DR6 with the bits x86 reads as 1, plus the bits of a hit being reported (measured on Windows
+// Server 2022 and 2025: 0xffff0515 for 0xffff0115 written, 0x500 for LE alone, 0xffff0ff1 for a B0 hit, 0xffff0ff0
+// from GetThreadContext inside the handler).
+struct ContextDebugRegisters {
+  uint64_t DR[4];
+  uint64_t DR6;
+  uint64_t DR7;
+};
+
+inline ContextDebugRegisters DebugRegistersForContext(const uint64_t* DR, uint64_t DR6, uint64_t DR7) {
+  if (!(DR7 & DR7_ACTIVE_MASK)) {
+    return {};
+  }
+  return {{DR[0], DR[1], DR[2], DR[3]}, DR6_READ_AS_ONE | DR6, DR7 | DR7_READ_AS_ONE};
+}
+
+// What the kernel keeps of debug registers a context sets: nothing while DR7 enables none, else DR0-DR3 and DR7 through
+// DR7_LEGAL_MASK; DR6 is never taken from a context. Until the thread runs with them they read back so (measured: DR7
+// 1 set on a suspended thread or one at a debug event reads 1); afterwards they read as the processor gives them back
+// (DebugRegistersForContext, 0x401).
+inline ContextDebugRegisters DebugRegistersAsKept(const uint64_t* DR, uint64_t DR7) {
+  if (!(DR7 & DR7_ACTIVE_MASK)) {
+    return {};
+  }
+  return {{DR[0], DR[1], DR[2], DR[3]}, 0, DR7 & DR7_LEGAL_MASK};
+}
+
+// WoW64 keeps a 32-bit thread's registers through that same kernel: an address set with nothing enabled gets LE so
+// that the kernel keeps it, and DR7 reads back through the 32-bit mask, without bit 10 (measured: Dr1 alone reads
+// back with DR7 0x100, Dr0 with DR7 1 reads DR7 1, all ones read 0xffff0155).
+inline uint64_t WowDebugRegisterDR7(const uint64_t* DR, uint64_t DR7) {
+  DR7 &= DR7_LEGAL_MASK_WOW64;
+  if (!(DR7 & DR7_ACTIVE_MASK) && (DR[0] | DR[1] | DR[2] | DR[3])) {
+    DR7 |= DR7_LE;
+  }
+  return DR7;
+}
+
+inline ContextDebugRegisters DebugRegistersForWowContext(const uint64_t* DR, uint64_t DR6, uint64_t DR7) {
+  auto Regs = DebugRegistersForContext(DR, DR6, DR7);
+  Regs.DR7 &= DR7_LEGAL_MASK_WOW64;
+  return Regs;
+}
+
+// A thread's enabled breakpoints in the form the JIT compiles them into its code: instruction breakpoints by
+// address (several registers on one address share an entry and set all their DR6 bits), data breakpoints as
+// byte ranges. Rebuilt from DR0-DR3 and DR7 whenever they change; a change invalidates the thread's compiled code.
+struct DebugBreakpoints {
+  struct Exec {
+    uint64_t Address;
+    uint8_t Mask; // DR6 bits to set when it hits
+    bool operator==(const Exec&) const = default;
+  };
+  struct Watch {
+    uint64_t Start;
+    uint8_t Length;
+    bool WriteOnly; // R/W = 1: only writes; R/W = 3: any access
+    uint8_t Bit;    // DR6 bit
+    bool operator==(const Watch&) const = default;
+  };
+  Exec Execs[4] {};
+  Watch Watches[4] {};
+  uint8_t NumExec {};
+  uint8_t NumWatch {};
+
+  bool Active() const {
+    return NumExec || NumWatch;
+  }
+
+  // The DR6 bits of the instruction breakpoints at this address, 0 for none
+  uint8_t ExecMaskAt(uint64_t Address) const {
+    for (uint32_t i = 0; i < NumExec; ++i) {
+      if (Execs[i].Address == Address) {
+        return Execs[i].Mask;
+      }
+    }
+    return 0;
+  }
+
+  bool operator==(const DebugBreakpoints& Other) const {
+    if (NumExec != Other.NumExec || NumWatch != Other.NumWatch) {
+      return false;
+    }
+    for (uint32_t i = 0; i < NumExec; ++i) {
+      if (!(Execs[i] == Other.Execs[i])) {
+        return false;
+      }
+    }
+    for (uint32_t i = 0; i < NumWatch; ++i) {
+      if (!(Watches[i] == Other.Watches[i])) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  static DebugBreakpoints FromRegisters(const uint64_t* DR, uint64_t DR7) {
+    DebugBreakpoints Result {};
+    for (uint32_t i = 0; i < 4; ++i) {
+      if (!((DR7 >> (2 * i)) & 1)) {
+        continue; // only the local enable bit, as Windows
+      }
+      const uint32_t RW = (DR7 >> (16 + 4 * i)) & 3;
+      const uint32_t LEN = (DR7 >> (18 + 4 * i)) & 3;
+      if (RW == 0) {
+        // An instruction breakpoint. The SDM leaves LEN other than 0 undefined; on an AMD EPYC under Windows such a
+        // breakpoint never fires, so it counts as disabled here.
+        if (LEN != 0) {
+          continue;
+        }
+        bool Merged = false;
+        for (uint32_t j = 0; j < Result.NumExec; ++j) {
+          if (Result.Execs[j].Address == DR[i]) {
+            Result.Execs[j].Mask |= 1 << i;
+            Merged = true;
+          }
+        }
+        if (!Merged) {
+          Result.Execs[Result.NumExec++] = {DR[i], static_cast<uint8_t>(1 << i)};
+        }
+      } else if (RW == 1 || RW == 3) {
+        const uint8_t Length = LEN == 0 ? 1 : LEN == 1 ? 2 : LEN == 3 ? 4 : 8;
+        // The processor ignores the address bits below the length: the range is aligned to it
+        Result.Watches[Result.NumWatch++] = {DR[i] & ~static_cast<uint64_t>(Length - 1), Length, RW == 1, static_cast<uint8_t>(i)};
+      }
+    }
+    return Result;
+  }
+};
+} // namespace FEXCore::X86State
