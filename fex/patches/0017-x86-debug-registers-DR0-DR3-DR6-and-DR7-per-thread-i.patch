+void ContextImpl::SetDebugRegisters(FEXCore::Core::InternalThreadState* Thread, const uint64_t* DR, uint64_t DR7) {
+  auto& State = Thread->CurrentFrame->State;
+  // The bits Windows keeps: local enables, LE, R/W and LEN
+  DR7 &= X86State::DR7_LEGAL_MASK;
+  memcpy(State.dr, DR, sizeof(State.dr));
+  State.dr7 = DR7;
+
+  const auto Breakpoints = X86State::DebugBreakpoints::FromRegisters(State.dr, DR7);
+  if (Breakpoints == Thread->DebugBreakpoints) {
+    return;
+  }
+  const bool WasActive = Thread->DebugBreakpoints.Active();
+  Thread->DebugBreakpoints = Breakpoints;
+  Thread->CurrentFrame->DebugWatchHit = 0;
+
+  // Blocks compiled with the previous breakpoints are stale. Compiled code is shared between threads, so a thread
+  // with breakpoints moves to a code buffer of its own: no other thread runs its instrumented blocks and it runs
+  // no block compiled without them. It keeps that buffer afterwards (going back would start a new shared
+  // generation and flush every thread's cache).
+  if (Breakpoints.Active() && !WasActive) {
+    Thread->CPUBackend->SetPrivateCodeBuffer(true);
+    ClearCodeCache(Thread, true);
+  } else {
+    ClearCodeCache(Thread, false);
+  }
+}
