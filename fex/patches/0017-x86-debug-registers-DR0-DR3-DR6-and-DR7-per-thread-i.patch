+    (void)tbz(TMP4, 63, &Miss);
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP4, Watch.Start);
+    sub(ARMEmitter::Size::i64Bit, TMP4, TMP4, TMP2);
+    (void)tbz(TMP4, 63, &Miss);
+    EmitDebugWatchHit(Watch.Bit);
+    (void)Bind(&Miss);
+  }
+  (void)Bind(&Done);
+}
