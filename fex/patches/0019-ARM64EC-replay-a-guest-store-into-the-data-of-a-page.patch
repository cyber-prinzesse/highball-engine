+  // Highball smc-precise: the instruction bytes this compilation decoded (consecutive instructions merged into ranges), so
+  // a write fault on one of its pages can tell a store into data from a store into code
+  fextl::vector<std::pair<uint64_t, uint64_t>> CodeRanges;
+  if (NeedsAddGuestCodeRanges) {
+    for (const auto& B : Thread->FrontendDecoder->GetDecodedBlockInfo()->Blocks) {
+      for (uint64_t i = 0; i < B.NumInstructions; i++) {
+        const auto& I = B.DecodedInstructions[i];
+        if (!I.InstSize) {
+          continue;
+        }
+        if (!CodeRanges.empty() && CodeRanges.back().first + CodeRanges.back().second == I.PC) {
+          CodeRanges.back().second += I.InstSize;
+        } else {
+          CodeRanges.emplace_back(I.PC, I.InstSize);
+        }
+      }
+    }
+  }
+
   // Insert to lookup cache
   for (auto [GuestAddr, HostAddr] : CompiledCode.EntryPoints) {
-    Thread->LookupCache->AddBlockMapping(Thread, GuestAddr, CodePages, HostAddr);
+    Thread->LookupCache->AddBlockMapping(Thread, GuestAddr, CodePages, HostAddr, CodeRanges);
   }
 
   // Clear any relocations that might have been generated
@@ -1219,6 +1238,27 @@ void ContextImpl::InvalidateCodeBuffersCodeRange(uint64_t Start, uint64_t Length
   }
 }
 
+// Highball smc-precise: MarkPageCode over every code buffer's map (as InvalidateCodeBuffersCodeRange), for the write fault
+// handler deciding whether a store into Page touches translated code. The caller holds CodeInvalidationMutex, so no
+// compilation adds blocks meanwhile.
+bool ContextImpl::SMCMarkPageCode(uint64_t Page, uint64_t Start, uint64_t Length, uint8_t* Mask) {
+  LOGMAN_THROW_A_FMT(CodeInvalidationMutex.try_lock() == false, "CodeInvalidationMutex needs to be unique_locked here");
+  std::scoped_lock lk {CodeBufferListLock};
+  bool Touches = false;
+  auto it = CodeBufferList.begin();
+  while (it != CodeBufferList.end()) {
+    if (auto Strong = it->lock()) {
+      auto& Map = *Strong->LookupCache;
+      auto rlk = Map.AcquireReadLock();
+      Touches |= Map.MarkPageCode(Page, Start, Length, Mask, rlk);
+      it++;
+    } else {
+      it = CodeBufferList.erase(it);
+    }
+  }
+  return Touches;
+}
+
