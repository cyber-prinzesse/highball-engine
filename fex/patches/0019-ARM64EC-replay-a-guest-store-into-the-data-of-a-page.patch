+namespace {
+// Highball smc-precise: the stores FEX's arm64 backend emits for guest memory, decoded from the faulting instruction.
+// Writeback forms, atomics, exclusives and structure stores are not replayed: the old path handles them.
+struct ReplayedStore {
+  uint64_t Address;
+  uint32_t Size;
+  alignas(16) uint8_t Data[32];
+};
+
+uint64_t SignExtend(uint64_t Value, unsigned Bits) {
+  const uint64_t Sign = 1ULL << (Bits - 1);
+  Value &= (1ULL << Bits) - 1;
+  return (Value ^ Sign) - Sign;
+}
+
+bool ExtendRegisterOffset(uint32_t Option, uint64_t Rm, uint64_t& Out) {
+  switch (Option) {
+  case 0b010: Out = static_cast<uint32_t>(Rm); return true;                                              // UXTW
+  case 0b011: Out = Rm; return true;                                                                     // LSL (UXTX)
+  case 0b110: Out = static_cast<uint64_t>(static_cast<int64_t>(static_cast<int32_t>(Rm))); return true;  // SXTW
+  case 0b111: Out = Rm; return true;                                                                     // SXTX
+  default: return false;
+  }
+}
+
+bool DecodeReplayableStore(uint32_t I, const uint64_t* X, uint64_t Sp, const __uint128_t* V, ReplayedStore& S) {
+  const uint32_t Rt = I & 31;
+  const uint32_t Rn = (I >> 5) & 31;
+  const uint64_t Base = Rn == 31 ? Sp : X[Rn];
+  auto GPR = [&](uint32_t R) -> uint64_t {
+    return R == 31 ? 0 : X[R]; // the zero register as data or offset
+  };
+  auto PutGPR = [&](uint32_t Offset, uint32_t R, uint32_t Bytes) {
+    const uint64_t Value = GPR(R);
+    memcpy(S.Data + Offset, &Value, Bytes);
+  };
+  auto PutV = [&](uint32_t Offset, uint32_t R, uint32_t Bytes) {
+    const __uint128_t Value = V[R];
+    memcpy(S.Data + Offset, &Value, Bytes);
+  };
+
+  // General registers, one element: STR (unsigned offset), STUR, STR (register), STLR, STLUR
+  if ((I & 0x3FC00000) == 0x39000000) {
+    const uint32_t Log2 = I >> 30;
+    S.Size = 1u << Log2;
+    S.Address = Base + (static_cast<uint64_t>((I >> 10) & 0xFFF) << Log2);
+    PutGPR(0, Rt, S.Size);
+    return true;
+  }
+  if ((I & 0x3FE00C00) == 0x38000000 || (I & 0x3FE00C00) == 0x19000000) {
+    S.Size = 1u << (I >> 30);
+    S.Address = Base + SignExtend((I >> 12) & 0x1FF, 9);
+    PutGPR(0, Rt, S.Size);
+    return true;
+  }
+  if ((I & 0x3FE00C00) == 0x38200800) {
+    const uint32_t Log2 = I >> 30;
+    uint64_t Offset;
+    if (!ExtendRegisterOffset((I >> 13) & 7, GPR((I >> 16) & 31), Offset)) {
+      return false;
+    }
+    if ((I >> 12) & 1) {
+      Offset <<= Log2;
+    }
+    S.Size = 1u << Log2;
+    S.Address = Base + Offset;
+    PutGPR(0, Rt, S.Size);
+    return true;
+  }
+  if ((I & 0x3FFFFC00) == 0x089FFC00) {
+    S.Size = 1u << (I >> 30);
+    S.Address = Base;
+    PutGPR(0, Rt, S.Size);
+    return true;
+  }
+  // General registers, a pair: STP (signed offset), STNP; opc 00 is 32-bit, 10 is 64-bit
+  if ((I & 0x3FC00000) == 0x29000000 || (I & 0x3FC00000) == 0x28000000) {
+    const uint32_t Opc = I >> 30;
+    if (Opc != 0 && Opc != 2) {
+      return false;
+    }
+    const uint32_t Element = Opc == 2 ? 8 : 4;
+    S.Size = 2 * Element;
+    S.Address = Base + SignExtend((I >> 15) & 0x7F, 7) * Element;
+    PutGPR(0, Rt, Element);
+    PutGPR(Element, (I >> 10) & 31, Element);
+    return true;
+  }
+  // SIMD and FP registers, one element: STR (unsigned offset), STUR, STR (register); opc<1> set with size 00 is 128-bit
+  auto SimdElement = [&](uint32_t& Bytes, uint32_t& Log2) -> bool {
+    const uint32_t Size = I >> 30;
+    if ((I >> 23) & 1) {
+      if (Size != 0) {
+        return false;
+      }
+      Bytes = 16;
+      Log2 = 4;
+    } else {
+      Bytes = 1u << Size;
+      Log2 = Size;
+    }
+    return true;
+  };
+  if ((I & 0x3F400000) == 0x3D000000) {
+    uint32_t Bytes, Log2;
+    if (!SimdElement(Bytes, Log2)) {
+      return false;
+    }
+    S.Size = Bytes;
+    S.Address = Base + (static_cast<uint64_t>((I >> 10) & 0xFFF) << Log2);
+    PutV(0, Rt, Bytes);
+    return true;
+  }
+  if ((I & 0x3F600C00) == 0x3C000000) {
+    uint32_t Bytes, Log2;
+    if (!SimdElement(Bytes, Log2)) {
+      return false;
+    }
+    S.Size = Bytes;
+    S.Address = Base + SignExtend((I >> 12) & 0x1FF, 9);
+    PutV(0, Rt, Bytes);
+    return true;
+  }
+  if ((I & 0x3F600C00) == 0x3C200800) {
+    uint32_t Bytes, Log2;
+    uint64_t Offset;
+    if (!SimdElement(Bytes, Log2) || !ExtendRegisterOffset((I >> 13) & 7, GPR((I >> 16) & 31), Offset)) {
+      return false;
+    }
+    if ((I >> 12) & 1) {
+      Offset <<= Log2;
+    }
+    S.Size = Bytes;
+    S.Address = Base + Offset;
+    PutV(0, Rt, Bytes);
+    return true;
+  }
+  // SIMD and FP registers, a pair: STP (signed offset), STNP; opc 00 is 32-bit, 01 64-bit, 10 128-bit
+  if ((I & 0x3FC00000) == 0x2D000000 || (I & 0x3FC00000) == 0x2C000000) {
+    const uint32_t Opc = I >> 30;
+    if (Opc == 3) {
+      return false;
+    }
+    const uint32_t Element = 4u << Opc;
+    S.Size = 2 * Element;
+    S.Address = Base + SignExtend((I >> 15) & 0x7F, 7) * Element;
+    PutV(0, Rt, Element);
+    PutV(Element, (I >> 10) & 31, Element);
+    return true;
+  }
+  return false;
+}
+
+void CountReplay(FEXCore::Core::InternalThreadState* Thread, uint64_t FEXCore::SHMStats::ThreadStats::* Field) {
+  if (Thread->ThreadStats) {
+    std::atomic_ref<uint64_t>(Thread->ThreadStats->*Field).fetch_add(1, std::memory_order_relaxed);
+  }
+}
