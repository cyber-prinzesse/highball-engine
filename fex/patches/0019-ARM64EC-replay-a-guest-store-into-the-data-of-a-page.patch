+
+bool InvalidationTracker::ReplayBurstExceeded(uint64_t Page) {
+  // NOTE: CodeInvalidationMutex is held by the caller. Past 32 replayed stores into one page within 100 ms, the old path
+  // (invalidate, leave writable) is cheaper: the page's later stores then cost nothing until its code runs again.
+  uint64_t Now, Frequency;
+  __asm__ volatile("mrs %0, cntvct_el0" : "=r"(Now));
+  __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(Frequency));
+  auto& Burst = ReplayBursts[(Page >> 12) % ReplayBursts.size()];
+  if (Burst.Page != Page || Now - Burst.WindowStart > Frequency / 10) {
+    Burst = {Page, Now, 0};
+  }
+  return ++Burst.Count > ReplayBurstLimit;
+}
+
+bool InvalidationTracker::TryReplayCodePageStore(FEXCore::Core::InternalThreadState* Thread, const uint64_t* X, uint64_t Sp,
+                                                 uint64_t& Pc, const __uint128_t* V, uint64_t FaultAddress) {
+  using Stats = FEXCore::SHMStats::ThreadStats;
+  {
+    std::shared_lock Lock(IntervalsLock);
+    if (!ReplayEnabled || SMCDetectionDisabled || !RWXIntervals.Query(FaultAddress).Enclosed) {
+      return false;
+    }
+  }
+
+  ReplayedStore S;
+  const uint32_t Instr = *reinterpret_cast<const uint32_t*>(Pc);
+  uint64_t Reason = 0;
+  if (!DecodeReplayableStore(Instr, X, Sp, V, S)) {
+    Reason = 1;
+  } else if (FaultAddress < S.Address || FaultAddress >= S.Address + S.Size) {
+    Reason = 2;
+  } else if ((S.Address & FEXCore::Utils::FEX_PAGE_MASK) != ((S.Address + S.Size - 1) & FEXCore::Utils::FEX_PAGE_MASK)) {
+    Reason = 3;
+  }
+  if (Reason) {
+    CountReplay(Thread, &Stats::AccumulatedSMCStoresUndecoded);
+    return false;
+  }
+  const uint64_t Page = S.Address & FEXCore::Utils::FEX_PAGE_MASK;
+
+  std::scoped_lock CodeLock(CTX.GetCodeInvalidationMutex());
+
+  // A store that leaves memory as it is changes nothing, code or data: no write, no invalidation. (The game's copy
+  // protection writes code bytes back unchanged most of the time.)
+  if (memcmp(reinterpret_cast<const void*>(S.Address), S.Data, S.Size) == 0) {
+    Pc += 4;
+    CountReplay(Thread, &Stats::AccumulatedSMCStoresUnchanged);
+    return true;
+  }
+
+  if (ReplayBurstExceeded(Page)) {
+    CountReplay(Thread, &Stats::AccumulatedSMCStoresUndecoded);
+    return false;
+  }
+
+  memset(ReplayMask.data(), 0, ReplayMask.size());
+  if (CTX.SMCMarkPageCode(Page, S.Address, S.Size, ReplayMask.data())) {
+    CountReplay(Thread, &Stats::AccumulatedSMCStoresOnCode);
+    return false;
+  }
+
+  // Write through a second, writable mapping of the page: the page itself stays protected for every thread, so another
+  // thread's write into code still faults and invalidates. (Opening the page for the store let such a write land unseen
+  // and run stale: smcdata.exe, 1,960 stale calls of 2,000.)
+  if (!FEX::Windows::UnixLib::AliasWrite(reinterpret_cast<void*>(S.Address), S.Data, S.Size)) {
+    CountReplay(Thread, &Stats::AccumulatedSMCStoresUndecoded);
+    return false;
+  }
+
+  Pc += 4;
+  CountReplay(Thread, &Stats::AccumulatedSMCStoresEmulated);
+  return true;
+}
