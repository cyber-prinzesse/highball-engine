+  // Highball smc-precise: marks in Mask (FEX_PAGE_SIZE entries, zeroed by the caller) the guest instruction bytes of
+  // every block compiled from Page, and returns whether [Start, Start + Length) overlaps any of them. A block whose
+  // bytes are unknown counts as an overlap, so the caller falls back to invalidating the page.
+  bool MarkPageCode(uint64_t Page, uint64_t Start, uint64_t Length, uint8_t* Mask, const LookupCacheReadLockToken&) const {
+    auto it = CodePages.find(Page >> 12);
+    if (it == CodePages.end()) {
+      return false;
+    }
+    bool Touches = false;
+    for (auto Address : it->second) {
+      auto bit = BlockList.find(Address);
+      if (bit == BlockList.end()) {
+        continue;
+      }
+      if (bit->second.Ranges.empty()) {
+        Touches = true;
+        continue;
+      }
+      for (const auto& [RStart, RLength] : bit->second.Ranges) {
+        if (RStart < Start + Length && Start < RStart + RLength) {
+          Touches = true;
+        }
+        const uint64_t First = std::max(RStart, Page);
+        const uint64_t Last = std::min(RStart + RLength, Page + FEXCore::Utils::FEX_PAGE_SIZE);
+        for (uint64_t a = First; a < Last; a++) {
+          Mask[a - Page] = 1;
+        }
+      }
+    }
+    return Touches;
+  }
