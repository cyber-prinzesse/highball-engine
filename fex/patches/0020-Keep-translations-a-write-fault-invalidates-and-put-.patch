+// Highball smc-retire: InvalidateCodeBuffersCodeRange for a write fault on code. Blocks whose bytes are known are kept
+// aside in their map (GuestToHostMap::RetiredBlock) for ReinstateRetired.
+void ContextImpl::RetireCodeBuffersCodeRange(uint64_t Start, uint64_t Length) {
+  FEXCORE_PROFILE_SCOPED("RetireCodeBuffersCodeRange");
+
+  LOGMAN_THROW_A_FMT(CodeInvalidationMutex.try_lock() == false, "CodeInvalidationMutex needs to be unique_locked here");
+  std::scoped_lock lk {CodeBufferListLock};
+  auto it = CodeBufferList.begin();
+  while (it != CodeBufferList.end()) {
+    if (auto Strong = it->lock()) {
+      Strong->LookupCache->InvalidateRange(Start, Length, true);
+      it++;
+    } else {
+      it = CodeBufferList.erase(it);
+    }
+  }
+}
+
+uint64_t ContextImpl::HashCodeRanges(std::span<const std::pair<uint64_t, uint64_t>> Ranges) {
+  uint64_t Hash = 0;
+  for (const auto& [Start, Size] : Ranges) {
+    Hash = XXH3_64bits_withSeed(reinterpret_cast<const void*>(Start), Size, Hash);
+  }
+  return Hash ? Hash : 1;
+}
+
+// Highball smc-retire: a retired block at GuestRIP in this thread's code buffer whose instruction bytes are back. The
+// caller holds CodeInvalidationMutex shared, so nothing retires or purges meanwhile. Its pages are protected again
+// before the bytes are hashed: a write after the protection faults and waits for this compilation to end, then
+// invalidates the reinstated block. Returns its host code, or 0 to translate.
+uintptr_t ContextImpl::ReinstateRetired(FEXCore::Core::InternalThreadState* Thread, uint64_t GuestRIP) {
+  auto& Map = *Thread->LookupCache->Shared;
+  std::array<GuestToHostMap::RetiredBlock, GuestToHostMap::GRAVE_WAYS> Found;
+  size_t Count;
+  uint64_t Generation;
+  {
+    auto lk = Map.AcquireReadLock();
+    Count = Map.FindRetired(GuestRIP, Found.data(), lk);
+    Generation = Map.ClearGeneration;
+  }
+  if (!Count) {
+    return 0;
+  }
+  if (HasCustomIRHandlers.load(std::memory_order_relaxed)) {
+    std::shared_lock lk(CustomIRMutex);
+    if (CustomIRHandlers.contains(GuestRIP)) {
+      return 0;
+    }
+  }
+
+  const std::array<uint64_t, 1> Entry {GuestRIP};
+  for (size_t i = 0; i < Count; i++) {
+    const auto& R = Found[i];
+    bool Executable = true;
+    for (auto Page : R.CodePages) {
+      Executable &= SyscallHandler->QueryGuestExecutableRange(Thread, Page).Size != 0;
+    }
+    if (!Executable) {
+      continue;
+    }
+    for (auto Page : R.CodePages) {
+      if (Thread->LookupCache->AddBlockExecutableRange(Thread, Entry, Page, FEXCore::Utils::FEX_PAGE_SIZE)) {
+        SyscallHandler->MarkGuestExecutableRange(Thread, Page, FEXCore::Utils::FEX_PAGE_SIZE);
+      }
+    }
+    if (HashCodeRanges(R.Ranges) != R.CodeHash) {
+      FEXCORE_PROFILE_INSTANT_INCREMENT(Thread, AccumulatedSMCRetiredMisses, 1);
+      continue;
+    }
+    if (!Thread->LookupCache->ReinstateRetiredBlock(Generation, R)) {
+      return 0;
+    }
+    FEXCORE_PROFILE_INSTANT_INCREMENT(Thread, AccumulatedSMCBlocksReinstated, 1);
+    return R.HostCode;
+  }
+  return 0;
+}
