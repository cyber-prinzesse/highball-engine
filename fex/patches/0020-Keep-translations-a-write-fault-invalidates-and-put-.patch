+  void RetireBlock(uint64_t Address, const LookupCacheWriteLockToken&) {
+    auto it = BlockList.find(Address);
+    if (it == BlockList.end() || !it->second.CodeHash || Retired.empty() || it->second.CodePages.empty()) {
