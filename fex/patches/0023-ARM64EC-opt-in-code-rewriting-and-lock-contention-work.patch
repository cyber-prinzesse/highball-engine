From: Gauthier Piarrette <gauthierpiarrette@gmail.com>
Subject: [PATCH] ARM64EC: opt-in work on code rewriting and lock contention (Microsoft Flight Simulator 2024)

Every switch is off unless its variable is set; with none set the build behaves as 0001-0022.

Measured on a base M4 in MSFS 2024 (2026-10-19, Gibraltar, three park-and-taxi windows a flight): the stutter is the
game's main thread recompiling code its copy protection rewrites (about 220 page invalidations a second; the game's
own code lives in the same read-write-execute memory).

- HB_FEX_SMC_SKIP_SAME=1: a write fault whose store writes the bytes already in memory is stepped over (PC + 4, the
  base register's writeback applied), the page kept protected and nothing invalidated, from translated or native code;
  release stores, exclusives, atomics and page-crossing stores take the old path, as does a page past
  HB_FEX_SMC_SKIP_BURST skips (default 64) within 100 ms. 36% of the invalidating faults in MSFS 2024.
- HB_FEX_SMC_GRAVE_SETS=N: the smc-retire graveyard's set count (default 4096, 4 ways).
- HB_FEX_SMC_HOT_MAXINST=N, HB_FEX_SMC_HOT_SECONDS=S (default 5): compile units starting on a page a write fault
  invalidated within S seconds are capped at N instructions and end at calls.
- HB_FEX_VM_FASTPATH=1: NtAllocateVirtualMemory, NtFreeVirtualMemory and NtProtectVirtualMemory calls that cannot
  concern translated code (no executable protection, no executable interval in the range) skip ThreadCreationMutex,
  which the memory notifications otherwise hold across the system call.
- HB_FEX_SMC_DEFER_CALLRET=1: the call-return stacks an invalidation must clear (a decommit and a commit each on
  Windows) are cleared after CodeInvalidationMutex is released, under ThreadCreationMutex.
- HB_FEX_WFE_US=N: how long a waiter on FEX's write-priority mutexes spins before it sleeps (default 10 us).
- HB_FEX_HOST_ZERO=1: FEX clears its own memory with one call into the unix library (fexunixlib_darwin.cpp
  ZeroPages, an mmap MAP_FIXED of zero pages) instead of an ntdll decommit and commit.
- HB_FEX_RWX_MAXINST, HB_FEX_RWX_NOCALLS: the same cap for every unit in read-write-execute memory (cost MSFS 2024 24%
  of its frame rate: not for use, kept for measurement).
- FEX_PROFILESTATS=1 counters (per thread): guest instructions translated and their read-write-execute share, compile
  time proper, waits for CodeInvalidationMutex (compile, link, write fault: wait and hold, with the hold's parts),
  ThreadCreationMutex waits and holds around memory calls, what each invalidating write fault writes (unchanged or
  changed bytes, from translated or native code, the last native PC), and the hot-page compiles.
---
diff --git a/FEXCore/Source/Interface/Context/Context.h b/FEXCore/Source/Interface/Context/Context.h
index 35b816b..b091bba 100644
--- a/FEXCore/Source/Interface/Context/Context.h
+++ b/FEXCore/Source/Interface/Context/Context.h
@@ -1,5 +1,7 @@
 // SPDX-License-Identifier: MIT
 #pragma once
+#include <FEXCore/Utils/SHMStats.h>
+#include <array>
 
 #include "Common/JitSymbols.h"
 #include "Interface/Core/CPUBackend.h"
@@ -230,6 +232,28 @@ public:
   bool SMCMarkPageCode(uint64_t Page, uint64_t Start, uint64_t Length, uint8_t* Mask) override;
   void RetireCodeBuffersCodeRange(uint64_t Start, uint64_t Length) override;
   void InvalidateThreadCachedCodeRange(FEXCore::Core::InternalThreadState* Thread, uint64_t Start, uint64_t Length) override;
+  void SetCallRetResetSink(CallRetResetSink* Sink) override {
+    HbCallRetSink = Sink;
+  }
+  void ResetThreadCallRetStack(FEXCore::Core::InternalThreadState* Thread) override;
+  CallRetResetSink* HbCallRetSink {}; // protected by CodeInvalidationMutex (exclusive)
+  // Highball HB_FEX_SMC_HOT_MAXINST: pages write faults invalidated, with when (cycle counter); a direct-mapped table
+  // written under CodeInvalidationMutex exclusive, read by compiles under it shared
+  struct HbHotPage {
+    uint64_t Page;
+    uint64_t Stamp;
+  };
+  std::array<HbHotPage, 8192> HbHotPages {};
+  void HbMarkSMCPage(uint64_t Page) override {
+    auto& E = HbHotPages[(Page >> 12) % HbHotPages.size()];
+    E.Page = Page;
+    E.Stamp = FEXCore::SHMStats::GetCycleCounter();
+  }
+  bool HbIsHotSMCPage(uint64_t Address, uint64_t WindowCycles) const {
+    const uint64_t Page = Address & ~0xFFFULL;
+    const auto& E = HbHotPages[(Page >> 12) % HbHotPages.size()];
+    return E.Page == Page && FEXCore::SHMStats::GetCycleCounter() - E.Stamp < WindowCycles;
+  }
   FEXCore::Utils::WritePriorityMutex::Mutex& GetCodeInvalidationMutex() override {
     return CodeInvalidationMutex;
   }
diff --git a/FEXCore/Source/Interface/Core/Core.cpp b/FEXCore/Source/Interface/Core/Core.cpp
index c0cedc9..97550d7 100644
--- a/FEXCore/Source/Interface/Core/Core.cpp
+++ b/FEXCore/Source/Interface/Core/Core.cpp
@@ -933,6 +933,14 @@ ContextImpl::CompileCodeResult ContextImpl::CompileCode(FEXCore::Core::InternalT
   // Generate IR + Meta Info
   auto [IRView, TotalInstructions, TotalInstructionsLength, StartAddr, Length, NeedsAddGuestCodeRanges] =
     GenerateIR(Thread, GuestRIP, Config.GDBSymbols(), MaxInst);
+  FEXCORE_PROFILE_INSTANT_INCREMENT(Thread, AccumulatedJITInstructions, TotalInstructions);
+  if (Thread->FrontendDecoder->IsEntryWritable()) {
+    FEXCORE_PROFILE_INSTANT_INCREMENT(Thread, AccumulatedJITWritableInstructions, TotalInstructions);
+  }
+  if (Thread->FrontendDecoder->IsEntryHot()) {
+    FEXCORE_PROFILE_INSTANT_INCREMENT(Thread, AccumulatedJITHotCount, 1);
+    FEXCORE_PROFILE_INSTANT_INCREMENT(Thread, AccumulatedJITHotInstructions, TotalInstructions);
+  }
   if (!IRView) {
     Thread->FrontendDecoder->ValidateDisownedOrFree();
     Thread->OpDispatcher->ValidateDisownedOrFree();
@@ -1005,7 +1013,11 @@ uintptr_t ContextImpl::CompileBlock(FEXCore::Core::CpuStateFrame* Frame, uint64_
   static_cast<ContextImpl*>(Thread->CTX)->SyscallHandler->PreCompile();
 
   // Invalidate might take a unique lock on this, to guarantee that during invalidation no code gets compiled
+  const uint64_t LockBegin = Thread->ThreadStats ? FEXCore::SHMStats::GetCycleCounter() : 0;
   auto lk = GuardSignalDeferringSection<std::shared_lock>(CodeInvalidationMutex, Thread);
+  if (Thread->ThreadStats) {
+    Thread->ThreadStats->AccumulatedJITLockWaitTime += FEXCore::SHMStats::GetCycleCounter() - LockBegin;
+  }
 
   // Is the code in the cache?
   // The backends only check L1 and L2, not L3
@@ -1075,7 +1087,16 @@ RecompileForSMC:
   // Accumulate a JIT count now, as even if another thread raced us, it should count as a compile.
   FEXCORE_PROFILE_INSTANT_INCREMENT(Thread, AccumulatedJITCount, 1);
 
+  const uint64_t CompileBegin = Thread->ThreadStats ? FEXCore::SHMStats::GetCycleCounter() : 0;
   auto [CompiledCode, DebugData, StartAddr, Length, NeedsAddGuestCodeRanges] = CompileCode(Thread, GuestRIP, MaxInst);
+  if (Thread->ThreadStats) {
+    const uint64_t Took = FEXCore::SHMStats::GetCycleCounter() - CompileBegin;
+    Thread->ThreadStats->AccumulatedJITCompileTime += Took;
+    if (Thread->FrontendDecoder->IsEntryWritable()) {
+      Thread->ThreadStats->AccumulatedJITWritableCount++;
+      Thread->ThreadStats->AccumulatedJITWritableTime += Took;
+    }
+  }
   auto CodePtr = CompiledCode.EntryPoints[GuestRIP];
   if (CodePtr == nullptr) {
     return 0;
@@ -1141,7 +1162,11 @@ RecompileForSMC:
     bool ProtectedNow = false;
     for (auto CodePage : BlockInfo->CodePages) {
       if (Thread->LookupCache->AddBlockExecutableRange(Thread, BlockInfo->EntryPoints, CodePage, FEXCore::Utils::FEX_PAGE_SIZE)) {
+        const uint64_t ProtectBegin = Thread->ThreadStats ? FEXCore::SHMStats::GetCycleCounter() : 0;
         SyscallHandler->MarkGuestExecutableRange(Thread, CodePage, FEXCore::Utils::FEX_PAGE_SIZE);
+        if (Thread->ThreadStats) {
+          Thread->ThreadStats->AccumulatedJITProtectTime += FEXCore::SHMStats::GetCycleCounter() - ProtectBegin;
+        }
         ProtectedNow = true;
       }
     }
@@ -1396,11 +1421,19 @@ void ContextImpl::InvalidateThreadCachedCodeRange(FEXCore::Core::InternalThreadS
   if (Thread->LookupCache->InvalidateCacheRange(Start, Length)) {
     FEXCORE_PROFILE_SCOPED("InvalidateCallRet");
 
+    if (HbCallRetSink && HbCallRetSink->Count < std::size(HbCallRetSink->Threads)) {
+      HbCallRetSink->Threads[HbCallRetSink->Count++] = Thread;
+      return;
+    }
     // This may cause access violations in the thread on Windows as zeroing is not atomic, this is handled by the frontend
     Allocator::VirtualDontNeed(Thread->CallRetStackBase, FEXCore::Core::InternalThreadState::CALLRET_STACK_SIZE);
   }
 }
 
+void ContextImpl::ResetThreadCallRetStack(FEXCore::Core::InternalThreadState* Thread) {
+  Allocator::VirtualDontNeed(Thread->CallRetStackBase, FEXCore::Core::InternalThreadState::CALLRET_STACK_SIZE);
+}
+
 void ContextImpl::ThreadRemoveCodeEntryFromJit(FEXCore::Core::CpuStateFrame* Frame, uint64_t GuestRIP) {
   static_cast<ContextImpl*>(Frame->Thread->CTX)->SyscallHandler->InvalidateGuestCodeRange(Frame->Thread, GuestRIP, 1);
 }
@@ -1515,3 +1548,9 @@ void ContextImpl::ConfigureAOTGen(FEXCore::Core::InternalThreadState* Thread, fe
   Thread->FrontendDecoder->SetExternalBranches(ExternalBranches);
 }
 } // namespace FEXCore::Context
+
+#ifdef _WIN32
+namespace FEXCore::Allocator {
+bool (*HbZeroPagesHook)(void* Ptr, size_t Size, uint32_t WinProt) = nullptr;
+}
+#endif
diff --git a/FEXCore/Source/Interface/Core/Frontend.cpp b/FEXCore/Source/Interface/Core/Frontend.cpp
index 75f17ce..ba522f5 100644
--- a/FEXCore/Source/Interface/Core/Frontend.cpp
+++ b/FEXCore/Source/Interface/Core/Frontend.cpp
@@ -6,6 +6,8 @@ desc: Extracts instruction & block meta info, frontend multiblock logic
 $end_info$
 */
 
+#include <FEXCore/Utils/SpinWaitLock.h>
+#include <cstdlib>
 #include "Interface/Context/Context.h"
 #include "Interface/Core/Frontend.h"
 #include "Interface/Core/OpcodeDispatcher.h"
@@ -1138,7 +1140,12 @@ void Decoder::BranchTargetInMultiblockRange() {
   const auto InstEnd = DecodeInst->PC + DecodeInst->InstSize;
 
   if (DecodeInst->TableInfo->Flags & FEXCore::X86Tables::InstFlags::FLAGS_CALL) {
-    if (ExecutableRangeWritable && CTX->AreMonoHacksActive()) {
+    // Highball (2026-10-19): HB_FEX_RWX_NOCALLS=1 stops at calls for any code in read-write-execute memory
+    static const bool RwxNoCalls = [] {
+      const char* Env = getenv("HB_FEX_RWX_NOCALLS");
+      return Env && Env[0] == '1';
+    }();
+    if (ExecutableRangeWritable && (CTX->AreMonoHacksActive() || RwxNoCalls || EntryHot)) {
       // Mono generated code often contains noreturn calls with garbage following them, and calls are always backpatched
       // after CIL compilation leading to n recompiles for a multiblock with n calls. Choose to minimize stutters over
       // raw performance and disable tracking past calls for mono generated code.
@@ -1772,6 +1779,32 @@ void Decoder::SetupDecodeInstructionsAtEntry(FEXCore::Core::InternalThreadState*
   if (MaxInst == 0) {
     MaxInst = CTX->Config.MaxInstPerBlock;
   }
+  // Highball (2026-10-19): code in read-write-execute memory, a copy protection's or a JIT's, is rewritten often, and
+  // each rewrite translates again the whole compile unit holding it, on the thread that runs it next.
+  // HB_FEX_RWX_MAXINST caps the instructions of a unit that starts there (0, the default, leaves it as it is).
+  static const uint64_t RwxMaxInst = [] {
+    const char* Env = getenv("HB_FEX_RWX_MAXINST");
+    return Env && Env[0] ? strtoull(Env, nullptr, 10) : 0ULL;
+  }();
+  EntryWritable = Thread && CTX->SyscallHandler && CTX->SyscallHandler->QueryGuestExecutableRange(Thread, PC).Writable;
+  // Highball (2026-10-19): HB_FEX_SMC_HOT_MAXINST caps a unit starting on a page a write fault invalidated within
+  // HB_FEX_SMC_HOT_SECONDS (default 5); such units also end at calls
+  static const uint64_t HotMaxInst = [] {
+    const char* Env = getenv("HB_FEX_SMC_HOT_MAXINST");
+    return Env && Env[0] ? strtoull(Env, nullptr, 10) : 0ULL;
+  }();
+  static const uint64_t HotWindow = [] {
+    const char* Env = getenv("HB_FEX_SMC_HOT_SECONDS");
+    const uint64_t Seconds = Env && Env[0] ? strtoull(Env, nullptr, 10) : 5ULL;
+    return FEXCore::Utils::SpinWaitLock::CycleCounterFrequency * (Seconds ? Seconds : 1);
+  }();
+  EntryHot = HotMaxInst && EntryWritable && CTX->HbIsHotSMCPage(PC, HotWindow);
+  if (EntryHot && MaxInst > HotMaxInst) {
+    MaxInst = HotMaxInst;
+  }
+  if (EntryWritable && RwxMaxInst && MaxInst > RwxMaxInst) {
+    MaxInst = RwxMaxInst;
+  }
   this->MaxInst = MaxInst;
   MaxCondBranchForward = 0;
   MaxCondBranchBackwards = ~0ULL;
