+++ b/FEXCore/Source/Interface/Core/JIT/JIT.cpp
@@ -598,8 +598,12 @@ uint64_t Arm64JITCore::ExitFunctionLink(FEXCore::Core::CpuStateFrame* Frame, FEX
   } else {
     {
       // Guard the LookupCache lock with the code invalidation mutex, to avoid issues with forking
+      const uint64_t LockBegin = Thread->ThreadStats ? FEXCore::SHMStats::GetCycleCounter() : 0;
       auto lk_inval =
         GuardSignalDeferringSection<std::shared_lock>(static_cast<Context::ContextImpl*>(Thread->CTX)->CodeInvalidationMutex, Thread);
+      if (Thread->ThreadStats) {
+        Thread->ThreadStats->AccumulatedLinkLockWaitTime += FEXCore::SHMStats::GetCycleCounter() - LockBegin;
+      }
       HostCode = Thread->LookupCache->FindBlock(Thread, GuestRip);
     }
     if (!HostCode) {
@@ -622,10 +626,14 @@ uint64_t Arm64JITCore::ExitFunctionLink(FEXCore::Core::CpuStateFrame* Frame, FEX
   ExpectedKnownCallMarkerEmit.adr(TMP1, 0xC);
 
   // Guard the LookupCache lock with the code invalidation mutex, to avoid issues with forking
+  const uint64_t LinkLockBegin = Thread->ThreadStats ? FEXCore::SHMStats::GetCycleCounter() : 0;
   auto lk_inval = GuardSignalDeferringSection<std::shared_lock>(static_cast<Context::ContextImpl*>(Thread->CTX)->CodeInvalidationMutex, Thread);
 
   // Lock here is necessary to prevent simultaneous linking and delinking
   auto lk = Thread->LookupCache->AcquireWriteLock();
+  if (Thread->ThreadStats) {
+    Thread->ThreadStats->AccumulatedLinkLockWaitTime += FEXCore::SHMStats::GetCycleCounter() - LinkLockBegin;
+  }
 
   // For non-calls, this would extend into the block's code, however that's fine as an out-of-range adr would never
   // be generated avoiding any false positives.
diff --git a/FEXCore/Source/Interface/Core/LookupCache.cpp b/FEXCore/Source/Interface/Core/LookupCache.cpp
index 544ab1a..249d612 100644
--- a/FEXCore/Source/Interface/Core/LookupCache.cpp
+++ b/FEXCore/Source/Interface/Core/LookupCache.cpp
@@ -24,7 +24,10 @@ GuestToHostMap::GuestToHostMap()
   // Highball smc-retire: opt-in (HB_FEX_SMC_RETIRE=1, see smc-precise's HB_FEX_SMC_REPLAY). Preallocated here so the
