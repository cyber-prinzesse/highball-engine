@@ -109,7 +109,8 @@ struct GuestToHostMap {
     fextl::vector<uint64_t> CodePages;
     fextl::vector<std::pair<uint64_t, uint64_t>> Ranges;
   };
-  static constexpr size_t GRAVE_SETS = 4096;
+  // Highball (2026-10-19): HB_FEX_SMC_GRAVE_SETS overrides the number of sets (default 4096)
+  size_t GraveSets = 4096;
   static constexpr size_t GRAVE_WAYS = 4;
   // Pages whose code was invalidated for any other reason (protection change, free, unmap, an untracked write) since a
   // block's retirement: such a block is not reinstated even when its bytes match, since what it was compiled against
@@ -122,8 +123,8 @@ struct GuestToHostMap {
   // Bumped by ClearCache: a reinstatement looked up before a clear is not committed after it
   uint64_t ClearGeneration {};
 
-  static size_t GraveSet(uint64_t Address) {
-    return (Address * 0x9E3779B97F4A7C15ULL >> 32) % GRAVE_SETS;
+  size_t GraveSet(uint64_t Address) const {
+    return (Address * 0x9E3779B97F4A7C15ULL >> 32) % GraveSets;
   }
   static size_t PurgeSlot(uint64_t PageNumber) {
     return (PageNumber * 0x9E3779B97F4A7C15ULL >> 40) % PURGE_SLOTS;
diff --git a/FEXCore/Source/Utils/SpinWaitLock.cpp b/FEXCore/Source/Utils/SpinWaitLock.cpp
index 3dba2d5..729e512 100644
--- a/FEXCore/Source/Utils/SpinWaitLock.cpp
+++ b/FEXCore/Source/Utils/SpinWaitLock.cpp
@@ -25,3 +25,17 @@ uint64_t CycleCounterFrequency = GetCycleCounterFrequency();
 uint64_t CyclesPerNanosecond = CalculateCyclesPerNanosecond();
 #endif
 } // namespace FEXCore::Utils::SpinWaitLock
+
+#ifdef ARCHITECTURE_arm64
+#include <FEXCore/Utils/WritePriorityMutex.h>
+#include <cstdlib>
+namespace FEXCore::Utils::WritePriorityMutex {
+uint64_t HbSpinCycles = 0;
+uint64_t HbComputeSpinCycles() {
+  const char* Env = getenv("HB_FEX_WFE_US");
+  uint64_t Us = Env && Env[0] ? strtoull(Env, nullptr, 10) : 10;
+  const uint64_t Cycles = FEXCore::Utils::SpinWaitLock::CycleCounterFrequency * (Us ? Us : 1) / 1'000'000ULL;
+  return Cycles ? Cycles : 1;
+}
+} // namespace FEXCore::Utils::WritePriorityMutex
+#endif
diff --git a/FEXCore/include/FEXCore/Core/Context.h b/FEXCore/include/FEXCore/Core/Context.h
index c3ed817..2cf8a59 100644
--- a/FEXCore/include/FEXCore/Core/Context.h
+++ b/FEXCore/include/FEXCore/Core/Context.h
@@ -162,6 +162,17 @@ public:
   FEX_DEFAULT_VISIBILITY virtual void RetireCodeBuffersCodeRange(uint64_t Start, uint64_t Length) = 0;
   FEX_DEFAULT_VISIBILITY virtual void
   InvalidateThreadCachedCodeRange(FEXCore::Core::InternalThreadState* Thread, uint64_t Start, uint64_t Length) = 0;
+  // Highball (2026-10-19): with a sink set (CodeInvalidationMutex held exclusively), InvalidateThreadCachedCodeRange
+  // records the threads whose call-return stack needs clearing instead of clearing it, for the caller to clear
+  // with ResetThreadCallRetStack once the mutex is dropped. Past the sink's room it clears them itself.
+  struct CallRetResetSink {
+    FEXCore::Core::InternalThreadState* Threads[64];
+    size_t Count;
+  };
+  FEX_DEFAULT_VISIBILITY virtual void SetCallRetResetSink(CallRetResetSink* Sink) = 0;
+  // Highball (2026-10-19): a write fault invalidated the code on Page just now (HB_FEX_SMC_HOT_MAXINST)
+  FEX_DEFAULT_VISIBILITY virtual void HbMarkSMCPage(uint64_t Page) = 0;
+  FEX_DEFAULT_VISIBILITY virtual void ResetThreadCallRetStack(FEXCore::Core::InternalThreadState* Thread) = 0;
   FEX_DEFAULT_VISIBILITY virtual FEXCore::Utils::WritePriorityMutex::Mutex& GetCodeInvalidationMutex() = 0;
 
   FEX_DEFAULT_VISIBILITY virtual void
diff --git a/FEXCore/include/FEXCore/Utils/AllocatorHooks.h b/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
index c4cadf4..a7d5e82 100644
--- a/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
+++ b/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
@@ -70,10 +70,17 @@ inline void VirtualFree(void* Ptr, size_t Size) {
   ::VirtualFree(Ptr, 0, MEM_RELEASE);
 }
 
+// Highball (2026-10-19): set by the ARM64EC frontend with HB_FEX_HOST_ZERO=1; zeroes the range in one host call and
+// returns true, or false for the ntdll path (protection it does not handle, no unix library entry)
+FEX_DEFAULT_VISIBILITY extern bool (*HbZeroPagesHook)(void* Ptr, size_t Size, uint32_t WinProt);
+
 inline void VirtualDontNeed(void* Ptr, size_t Size, bool Recommit = true) {
   // Zero the page-aligned region, preserving permissions.
   MEMORY_BASIC_INFORMATION Info;
   ::VirtualQuery(Ptr, &Info, sizeof(Info));
+  if (HbZeroPagesHook && Info.State == MEM_COMMIT && HbZeroPagesHook(Ptr, Size, Info.Protect)) {
+    return;
+  }
   ::VirtualFree(Ptr, Size, MEM_DECOMMIT);
   if (Recommit) {
     ::VirtualAlloc(Ptr, Size, MEM_COMMIT, Info.Protect);
diff --git a/FEXCore/include/FEXCore/Utils/SHMStats.h b/FEXCore/include/FEXCore/Utils/SHMStats.h
index 0adf21d..d34f8f8 100644
--- a/FEXCore/include/FEXCore/Utils/SHMStats.h
+++ b/FEXCore/include/FEXCore/Utils/SHMStats.h
@@ -84,6 +84,39 @@ struct ThreadStats {
   // Highball smc-retire
   uint64_t AccumulatedSMCRetiredMisses;    // a retired block at the entry point, its instruction bytes different: translated
   uint64_t AccumulatedSMCBlocksReinstated; // a retired block put back, its instruction bytes the same: not translated
+  // Highball (2026-10-19): where translation time goes
+  uint64_t AccumulatedJITInstructions;  // guest instructions translated
+  uint64_t AccumulatedJITWritableCount; // compiles whose entry point lies in read-write-execute memory
+  uint64_t AccumulatedJITWritableTime;  // their compile time (cycles)
+  uint64_t AccumulatedJITCompileTime;   // compile time proper: decoding, IR, code generation (cycles)
+  uint64_t AccumulatedJITLockWaitTime;  // a compile waiting for CodeInvalidationMutex shared (cycles)
+  uint64_t AccumulatedLinkLockWaitTime; // block linking waiting for CodeInvalidationMutex and the lookup cache (cycles)
+  uint64_t AccumulatedSMCLockWaitTime;  // a write fault on code waiting for CodeInvalidationMutex exclusive (cycles)
+  uint64_t AccumulatedSMCLockHoldTime;  // a write fault holding it: invalidation and the page's protection (cycles)
+  uint64_t AccumulatedJITWritableInstructions; // guest instructions of the compiles starting in read-write-execute memory
+  uint64_t AccumulatedJITProtectTime;  // a compile protecting the pages of its new code against writes (cycles)
+  // ARM64EC's ThreadCreationMutex, held across every memory allocation, free and protection change of the process
+  uint64_t AccumulatedTCMWaitTime;     // memory-call notifications waiting for it (cycles)
+  uint64_t AccumulatedAVTCMWaitTime;   // the access-violation handler waiting for it (cycles)
+  uint64_t AccumulatedVMNotifyCount;   // memory calls notified
