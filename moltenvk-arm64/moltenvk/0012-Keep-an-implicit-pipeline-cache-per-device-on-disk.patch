-	compileLibrary(msl, specializationMacroDef);
+	if (specializationMacroDef) {
+		string msl;
+		decompressMSL(msl);
+		compileLibrary(msl, specializationMacroDef);
+	} else {
+		_hbLazy.store(true, std::memory_order_release);	// Highball implicit pipeline cache: compiled on first use
+	}
 }
 
 void MVKShaderLibrary::compileLibrary(const string& msl,
@@ -276,6 +281,7 @@ static uint32_t getWorkgroupDimensionSize(const SPIRVWorkgroupSizeDimension& wgD
 	_mtlLibrary = [other._mtlLibrary retain];
 	_shaderConversionResultInfo = other._shaderConversionResultInfo;
 	_compressedMSL = other._compressedMSL;
+	_hbLazy.store(other._hbLazy.load(std::memory_order_acquire), std::memory_order_release);
 }
 
 MVKShaderLibrary& MVKShaderLibrary::operator=(const MVKShaderLibrary& other) {
@@ -286,6 +292,7 @@ static uint32_t getWorkgroupDimensionSize(const SPIRVWorkgroupSizeDimension& wgD
 	_owner = other._owner;
 	_shaderConversionResultInfo = other._shaderConversionResultInfo;
 	_compressedMSL = other._compressedMSL;
+	_hbLazy.store(other._hbLazy.load(std::memory_order_acquire), std::memory_order_release);
 	return *this;
 }
 
@@ -401,6 +408,7 @@ static uint32_t getWorkgroupDimensionSize(const SPIRVWorkgroupSizeDimension& wgD
 	if ( !mvkLib ) {
 		uint64_t startTime = pShaderFeedback ? mvkGetTimestamp() : getPerformanceTimestamp();
 		MVKPipelineCache* pipelineCache = pipeline->getPipelineCache();
+		if ( !pipelineCache ) { pipelineCache = getDevice()->getImplicitPipelineCache(); }	// Highball implicit pipeline cache
 		if (pipelineCache) {
 			mvkLib = pipelineCache->getShaderLibrary(pShaderConfig, this, pipeline, pShaderFeedback, startTime);
 		} else {
@@ -742,3 +750,16 @@ static uint32_t getWorkgroupDimensionSize(const SPIRVWorkgroupSizeDimension& wgD
 	[_mtlFunction release];
 }
 
+
+
+// Highball implicit pipeline cache: a library read from cache data compiles its MSL the first time a function is
+// asked for. One compile per library, whichever thread comes first; the others wait on the lock.
+void MVKShaderLibrary::hbCompileLazily() {
+	if ( !_hbLazy.load(std::memory_order_acquire) ) { return; }
+	std::lock_guard<std::mutex> lock(_hbLazyLock);
+	if ( !_hbLazy.load(std::memory_order_acquire) ) { return; }
+	std::string msl;
+	decompressMSL(msl);
+	if ( !msl.empty() ) { compileLibrary(msl, nullptr); }
+	_hbLazy.store(false, std::memory_order_release);
+}
