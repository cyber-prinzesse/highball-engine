+
+#pragma mark -
+#pragma mark Highball implicit pipeline cache
+
+// Highball implicit pipeline cache: the device keeps a pipeline cache of its own for the pipelines created without
+// one, reads it from a file at creation and writes it back every 60 s when it grew and at destruction, so the
+// SPIR-V to MSL conversions of one run serve the next. readData() rejects data from another MoltenVK build or GPU
+// through the header.
+#include "MVKPipeline.h"
+#include <atomic>
+#include <fstream>
+#include <iterator>
+#include <unistd.h>
+#include <limits.h>
+
+static std::mutex hbImplicitCacheLock;
+
+// The folder: HB_MVK_PIPELINE_CACHE (0 for none, a relative one goes under the user's cache folder), or
+// highball/<program name> under the user's cache folder, the program name being the Windows executable's (Wine
+// sets it with setprogname). One file per VkDevice created in the process, in creation order, named with this
+// build's pipelineCacheUUID, since readData() only accepts data written by the same build on the same GPU.
+void MVKDevice::hbInitImplicitPipelineCache() {
+	static std::atomic<unsigned> deviceIndex{0};
+	const char* env = getenv("HB_MVK_PIPELINE_CACHE");
+	if (env && !strcmp(env, "0")) { return; }
+	std::string dir = (env && *env) ? env : std::string("highball/") + getprogname();
+	if (dir[0] != '/') {
+		char buf[PATH_MAX];
+		size_t len = confstr(_CS_DARWIN_USER_CACHE_DIR, buf, sizeof(buf));
+		if ( !len || len >= sizeof(buf) ) { return; }
+		if (len >= 2 && buf[len - 2] == '/') { buf[len - 2] = 0; }
+		dir = std::string(buf) + "/" + dir;
+	}
+	[[NSFileManager defaultManager] createDirectoryAtPath: [NSString stringWithUTF8String: dir.c_str()] withIntermediateDirectories: YES attributes: nil error: nil];
+	char uuid[VK_UUID_SIZE * 2 + 1];
+	auto& dvcProps = _physicalDevice->_properties;
+	for (size_t i = 0; i < VK_UUID_SIZE; i++) { snprintf(uuid + i * 2, 3, "%02x", dvcProps.pipelineCacheUUID[i]); }
+	std::string path = dir + "/moltenvk-" + uuid + "-" + std::to_string(++deviceIndex) + ".bin";
+	std::vector<char> data;
+	{
+		std::ifstream in(path, std::ios::binary);
+		if (in) { data.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>()); }
+	}
+	VkPipelineCacheCreateInfo info = { VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO, nullptr, 0, data.size(), data.data() };
+	_implicitPipelineCache = new MVKPipelineCache(this, &info);
+	_implicitPipelineCachePath = path;
+	_implicitPipelineCacheWritten = _implicitPipelineCache->hbGeneration();
+	MVKLogInfo("Highball: implicit pipeline cache %s, %lu bytes read.", path.c_str(), (unsigned long)data.size());
+	// A utility queue: a background one is starved for minutes while a game saturates the CPUs.
+	_implicitPipelineCacheTimer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_global_queue(QOS_CLASS_UTILITY, 0));
+	dispatch_source_set_timer(_implicitPipelineCacheTimer, dispatch_time(DISPATCH_TIME_NOW, 60 * NSEC_PER_SEC), 60 * NSEC_PER_SEC, 5 * NSEC_PER_SEC);
+	dispatch_source_set_event_handler(_implicitPipelineCacheTimer, ^{ hbFlushImplicitPipelineCache(); });
+	dispatch_resume(_implicitPipelineCacheTimer);
+}
+
+void MVKDevice::hbFlushImplicitPipelineCache() {
+	std::lock_guard<std::mutex> lock(hbImplicitCacheLock);
+	if ( !_implicitPipelineCache ) { return; }
+	uint64_t gen = _implicitPipelineCache->hbGeneration();
+	if (gen == _implicitPipelineCacheWritten) { return; }
+	std::vector<char> data;
+	if (_implicitPipelineCache->hbWriteAll(data) != VK_SUCCESS || data.empty()) { return; }
+	size_t size = data.size();
+	std::string tmp = _implicitPipelineCachePath + ".tmp";
+	{
+		std::ofstream out(tmp, std::ios::binary | std::ios::trunc);
+		if ( !out ) { return; }
+		out.write(data.data(), size);
+	}
+	if (rename(tmp.c_str(), _implicitPipelineCachePath.c_str()) != 0) { return; }
+	_implicitPipelineCacheWritten = gen;
+	MVKLogInfo("Highball: implicit pipeline cache written, %lu bytes, %llu shader libraries added since the read.",
+			   (unsigned long)size, (unsigned long long)gen);
+}
+
+void MVKDevice::hbTearDownImplicitPipelineCache() {
+	if ( !_implicitPipelineCache ) { return; }
+	if (_implicitPipelineCacheTimer) {
+		dispatch_semaphore_t cancelled = dispatch_semaphore_create(0);
+		dispatch_source_set_cancel_handler(_implicitPipelineCacheTimer, ^{ dispatch_semaphore_signal(cancelled); });
+		dispatch_source_cancel(_implicitPipelineCacheTimer);
+		dispatch_semaphore_wait(cancelled, DISPATCH_TIME_FOREVER);
+		dispatch_release(_implicitPipelineCacheTimer);
+		_implicitPipelineCacheTimer = nullptr;
+	}
+	hbFlushImplicitPipelineCache();
+	std::lock_guard<std::mutex> lock(hbImplicitCacheLock);
+	_implicitPipelineCache->destroy();
+	_implicitPipelineCache = nullptr;
+}
