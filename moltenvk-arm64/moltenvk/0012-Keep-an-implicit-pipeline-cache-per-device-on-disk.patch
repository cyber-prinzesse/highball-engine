 	 * pipeline's pipeline cache, or compiled from source in the shader module.
@@ -521,6 +527,7 @@ protected:
 
 	std::unordered_map<MVKShaderModuleKey, MVKShaderLibraryCache*> _shaderCache;
 	size_t _dataSize = 0;
+	uint64_t _hbGeneration = 0;	// Highball implicit pipeline cache: shader libraries added since creation
 	std::mutex _shaderCacheLock;
 	bool _isExternallySynchronized = false;
 	bool _isMergeInternallySynchronized = false;
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm b/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm
index 7a25708..99d52a6 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm
@@ -2590,7 +2590,7 @@ static void setEmulatedReversedDepthViewportConfig(SPIRVToMSLConversionConfigura
 	bool wasAdded = false;
 	MVKShaderLibraryCache* slCache = getShaderLibraryCache(shaderModule->getKey());
 	MVKShaderLibrary* shLib = slCache->getShaderLibrary(pContext, shaderModule, pipeline, &wasAdded, pShaderFeedback, startTime);
-	if (wasAdded) { markDirty(); }
+	if (wasAdded) { markDirty(); _hbGeneration++; }	// Highball implicit pipeline cache
 	else if (pShaderFeedback) { mvkEnableFlags(pShaderFeedback->flags, VK_PIPELINE_CREATION_FEEDBACK_APPLICATION_PIPELINE_CACHE_HIT_BIT); }
 	return shLib;
 }
@@ -2880,6 +2880,7 @@ void serialize(Archive & archive, CompilerMSL::Options& opt) {
 				opt.view_index_from_device_index,
 				opt.dispatch_base,
 				opt.texture_1D_as_2D,
+				opt.texture_2D_as_2D_array,	// Highball: SPIRV-Cross patch 0004's option, compared by matches()
 				opt.emulate_reversed_depth_viewport,
 				opt.argument_buffers,
 				opt.argument_buffers_tier,
@@ -3210,3 +3211,18 @@ void mvkValidateCeralArchiveDefinitions() {
 	missingBytes += mvkValidateCerealArchiveSize<MVKCompressor<std::string>>(20);				// Contains collection
 	assert(missingBytes == 0 && "Cereal Archive definitions incomplete. See previous logged errors.");
 }
+
+
+// Highball implicit pipeline cache: writeData() needs two calls, one for the size and one for the data, and a
+// library added between them resets the size, so a live cache is written with the lock held across both.
+VkResult MVKPipelineCache::hbWriteAll(std::vector<char>& out) {
+	lock_guard<mutex> lock(_shaderCacheLock);
+	size_t size = 0;
+	VkResult rslt = writeDataImpl(&size, nullptr);
+	if (rslt != VK_SUCCESS) { return rslt; }
+	if ( !size ) { out.clear(); return VK_SUCCESS; }
+	out.resize(size);
+	rslt = writeDataImpl(&size, out.data());
+	if (rslt == VK_SUCCESS) { out.resize(size); }
+	return rslt;
+}
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.h b/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.h
