 // Either returns an existing pipeline state or compiles a new one.
+// Highball pass variants (mvk_pass_variants.py). D3D12 lets a pipeline carry more colour targets than the pass binds
+// (writes to unbound targets are discarded), a depth-less pipeline draw with a depth buffer bound (ignored), and a
+// pipeline's colour format differ from the target's; Metal's validation calls each undefined and Apple GPUs hang on
+// them. The Metal pipeline state is rebuilt against the live pass's formats, once per distinct pass shape, and cached.
+static bool hbPassVariantsOn() { static const bool on = getenv("HB_MVK_PASS_VARIANTS") == nullptr || getenv("HB_MVK_PASS_VARIANTS")[0] != '0'; return on; }
+
+id<MTLRenderPipelineState> MVKGraphicsPipeline::hbPipelineStateForPass(MVKCommandEncoder* cmdEncoder, uint8_t dynPrimitiveType) {
+	if ( !hbPassVariantsOn() || !_mtlPipelineState ) { return _mtlPipelineState; }
+	MVKRenderSubpass* sp = cmdEncoder->getSubpass();
+	if ( !sp ) { return _mtlPipelineState; }
+	if ( !_hbPLDesc ) { return _mtlPipelineState; }
+	std::lock_guard<std::mutex> l(_hbVariantsLock);	// held throughout, one variant build at a time per pipeline
+	MVKPixelFormats* pixFmts = getPixelFormats();
+	MTLPixelFormat passClr[8];
+	const uint32_t caCnt = std::min<uint32_t>(sp->getColorAttachmentCount(), 8);
+	for (uint32_t i = 0; i < 8; i++) { passClr[i] = i < caCnt ? pixFmts->getMTLPixelFormat(sp->getColorAttachmentFormat(i)) : MTLPixelFormatInvalid; }
+	const MTLPixelFormat dFmt = pixFmts->getMTLPixelFormat(sp->getDepthFormat());
+	const MTLPixelFormat sFmt = pixFmts->getMTLPixelFormat(sp->getStencilFormat());
+	const MTLPixelFormat passDepth = pixFmts->isDepthFormat(dFmt) ? dFmt : (pixFmts->isDepthFormat(sFmt) ? sFmt : MTLPixelFormatInvalid);
+	const MTLPixelFormat passStencil = pixFmts->isStencilFormat(sFmt) ? sFmt : (pixFmts->isStencilFormat(dFmt) ? dFmt : MTLPixelFormatInvalid);
+	bool same = (_hbPLDesc.depthAttachmentPixelFormat == passDepth) && (_hbPLDesc.stencilAttachmentPixelFormat == passStencil);
+	for (uint32_t i = 0; i < 8 && same; i++) {
+		const MTLPixelFormat pf = _hbPLDesc.colorAttachments[i].pixelFormat;
+		// a pass attachment the pipeline does not write is fine; everything else needs the variant
+		if (pf != passClr[i] && !(pf == MTLPixelFormatInvalid && passClr[i] != MTLPixelFormatInvalid)) { same = false; }
+	}
+	// the primitive class: a triangle pipeline drawing lines or points under dynamic topology (or the reverse) gets a
+	// variant declaring the drawn class; a Point class stays (MoltenVK's polygon-mode-point form) and so does none
+	const uint8_t prim = _dynamicStateFlags.has(MVKRenderStateFlag::PrimitiveTopology) ? dynPrimitiveType : getStaticStateData().primitiveType;
+	const MTLPrimitiveTopologyClass drawnClass = (prim == MTLPrimitiveTypePoint) ? MTLPrimitiveTopologyClassPoint
+		: (prim == MTLPrimitiveTypeLine || prim == MTLPrimitiveTypeLineStrip) ? MTLPrimitiveTopologyClassLine : MTLPrimitiveTopologyClassTriangle;
+	const MTLPrimitiveTopologyClass plClass = _hbPLDesc.inputPrimitiveTopology;
+	const bool classDiff = plClass != MTLPrimitiveTopologyClassUnspecified && plClass != MTLPrimitiveTopologyClassPoint && plClass != drawnClass;
+	if (same && !classDiff) { return _mtlPipelineState; }
+	uint64_t key = ((uint64_t)passDepth << 48) ^ ((uint64_t)passStencil << 40) ^ ((uint64_t)(classDiff ? drawnClass : 0) << 36);
+	for (uint32_t i = 0; i < 8; i++) { key = (key * 1099511628211ull) ^ (uint64_t)passClr[i]; }
+	{
+		auto it = _hbVariants.find(key);
+		if (it != _hbVariants.end()) { return it->second ? it->second : _mtlPipelineState; }
+	}
+	MTLRenderPipelineDescriptor* desc = [_hbPLDesc copy];
+	std::string what;
+	for (uint32_t i = 0; i < 8; i++) {
+		MTLRenderPipelineColorAttachmentDescriptor* ca = desc.colorAttachments[i];
+		if (ca.pixelFormat == passClr[i]) { continue; }
+		if (passClr[i] == MTLPixelFormatInvalid) {
+			if (ca.pixelFormat != MTLPixelFormatInvalid) { what += " c" + std::to_string(i) + "->none"; ca.pixelFormat = MTLPixelFormatInvalid; ca.blendingEnabled = NO; }
+		} else if (ca.pixelFormat != MTLPixelFormatInvalid) {
+			what += " c" + std::to_string(i) + ":" + std::to_string((unsigned long)ca.pixelFormat) + "->" + std::to_string((unsigned long)passClr[i]);
+			ca.pixelFormat = passClr[i];
+			if (ca.blendingEnabled && !(pixFmts->getCapabilities(passClr[i]) & kMVKMTLFmtCapsBlend)) { ca.blendingEnabled = NO; }
+		}
+	}
+	if (desc.depthAttachmentPixelFormat != passDepth) { what += " d:" + std::to_string((unsigned long)desc.depthAttachmentPixelFormat) + "->" + std::to_string((unsigned long)passDepth); desc.depthAttachmentPixelFormat = passDepth; }
+	if (desc.stencilAttachmentPixelFormat != passStencil) { what += " s:" + std::to_string((unsigned long)desc.stencilAttachmentPixelFormat) + "->" + std::to_string((unsigned long)passStencil); desc.stencilAttachmentPixelFormat = passStencil; }
+	if (classDiff) { what += " class:" + std::to_string((unsigned long)plClass) + "->" + std::to_string((unsigned long)drawnClass); desc.inputPrimitiveTopology = drawnClass; }
+	MVKRenderPipelineCompiler* plc = new MVKRenderPipelineCompiler(this);
+	id<MTLRenderPipelineState> state = plc->newMTLRenderPipelineState(desc);	// retained; the compiler logs a failure
+	plc->destroy();
+	[desc release];
+	static std::atomic<int> logged {0};
+	if (logged.fetch_add(1) < 60) { fprintf(stderr, "[hb-pass-variant] pipeline %p%s: %s\n", this, what.c_str(), state ? "built" : "FAILED, base kept"); }
+	_hbVariants[key] = state;
+	return state ? state : _mtlPipelineState;
+}
