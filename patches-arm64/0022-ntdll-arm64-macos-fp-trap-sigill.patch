+        else if (esr & ESR_ELx_ISS_FP_OFF) rec.ExceptionCode = EXCEPTION_FLT_OVERFLOW;
+        else if (esr & ESR_ELx_ISS_FP_UFF) rec.ExceptionCode = EXCEPTION_FLT_UNDERFLOW;
+        else if (esr & ESR_ELx_ISS_FP_IXF) rec.ExceptionCode = EXCEPTION_FLT_INEXACT_RESULT;
+        else if (esr & ESR_ELx_ISS_FP_IDF) rec.ExceptionCode = EXCEPTION_FLT_DENORMAL_OPERAND;
+        else rec.ExceptionCode = EXCEPTION_FLT_INVALID_OPERATION;
+        save_context( &context, sigcontext );
+        setup_raise_exception( data, sigcontext, &rec, &context );
