+/***********************************************************************
+ *           clear_fpcr_traps
+ *
+ * Clear the floating-point trap enables in a sigcontext, so that the code
+ * the signal returns to (the exception dispatcher) cannot trap. The CONTEXT
+ * keeps the thread's FPCR for NtContinue.
+ */
+static void clear_fpcr_traps( ucontext_t *sigcontext )
+{
+#ifdef linux
+    struct fpsimd_context *fp = get_fpsimd_context( sigcontext );
+
+    if (fp) fp->fpcr &= ~FPCR_TRAP_ENABLES;
+#elif defined(__APPLE__)
+    sigcontext->uc_mcontext->__ns.__fpcr &= ~FPCR_TRAP_ENABLES;
 #endif
 }
 
