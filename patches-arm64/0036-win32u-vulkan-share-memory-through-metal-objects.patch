+/* Highball metal-shared-memory: a host without fd memory (MoltenVK) shares Vulkan memory as a Metal object
+ * through VK_EXT_external_memory_metal: an image's MTLTexture, a buffer's MTLBuffer, otherwise the MTLHeap. The
+ * Windows side is unchanged: the memory still gets a D3DKMT resource and its NT or global handle. The resource
+ * carries a pipe instead of a host fd, and this process keeps the Metal object under the pipe's inode, so a shared
+ * resource opens again in the process that created it (Media Foundation video into a D3D12 renderer, MSFS 2024's
+ * start screen). Another process cannot open it yet: that needs an IOSurface. */
+enum host_memory_kind { HOST_MEMORY_HEAP, HOST_MEMORY_BUFFER, HOST_MEMORY_IMAGE };
+
+struct metal_shared_object
+{
+    struct list entry;
+    dev_t dev;
+    ino_t ino;
+    VkExternalMemoryHandleTypeFlagBits type;
+    void *handle;
+};
+
+static struct list metal_shared_objects = LIST_INIT( metal_shared_objects );
+static pthread_mutex_t metal_shared_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static BOOL host_memory_is_metal(void)
+{
+    struct vulkan_device_extensions extensions = {.has_VK_KHR_external_memory_win32 = 1};
+    driver_funcs->p_map_device_extensions( &extensions );
+    return !extensions.has_VK_KHR_external_memory_fd && extensions.has_VK_EXT_external_memory_metal;
+}
+
+static VkExternalMemoryHandleTypeFlagBits get_host_external_memory_type_for( enum host_memory_kind kind )
+{
+    if (!host_memory_is_metal()) return get_host_external_memory_type();
+    switch (kind)
+    {
+    case HOST_MEMORY_IMAGE: return VK_EXTERNAL_MEMORY_HANDLE_TYPE_MTLTEXTURE_BIT_EXT;
+    case HOST_MEMORY_BUFFER: return VK_EXTERNAL_MEMORY_HANDLE_TYPE_MTLBUFFER_BIT_EXT;
+    default: return VK_EXTERNAL_MEMORY_HANDLE_TYPE_MTLHEAP_BIT_EXT;
+    }
+}
+
+/* keep a Metal object for this process and return the fd that stands for it in a D3DKMT resource */
+static int metal_shared_register( VkExternalMemoryHandleTypeFlagBits type, void *handle, dev_t *dev, ino_t *ino )
+{
+    struct metal_shared_object *object;
+    struct stat st;
+    int fds[2];
+
+    if (pipe( fds )) return -1;
+    close( fds[1] );
+    if (fstat( fds[0], &st ) || !(object = calloc( 1, sizeof(*object) )))
+    {
+        close( fds[0] );
+        return -1;
+    }
+    object->dev = *dev = st.st_dev;
+    object->ino = *ino = st.st_ino;
+    object->type = type;
+    object->handle = handle;
+
+    pthread_mutex_lock( &metal_shared_lock );
+    list_add_tail( &metal_shared_objects, &object->entry );
+    pthread_mutex_unlock( &metal_shared_lock );
+    TRACE( "registered Metal object %p type %#x as inode %llu\n", handle, type, (unsigned long long)st.st_ino );
+    return fds[0];
+}
+
+static void metal_shared_unregister( dev_t dev, ino_t ino )
+{
+    struct metal_shared_object *object;
+
+    pthread_mutex_lock( &metal_shared_lock );
+    LIST_FOR_EACH_ENTRY( object, &metal_shared_objects, struct metal_shared_object, entry )
+    {
+        if (object->dev != dev || object->ino != ino) continue;
+        list_remove( &object->entry );
+        free( object );
+        break;
+    }
+    pthread_mutex_unlock( &metal_shared_lock );
+}
+
+/* the Metal object behind a D3DKMT resource's fd, called with metal_shared_lock held */
+static BOOL metal_shared_lookup( int fd, VkExternalMemoryHandleTypeFlagBits *type, void **handle )
+{
+    struct metal_shared_object *object;
+    struct stat st;
+
+    if (fstat( fd, &st )) return FALSE;
+    LIST_FOR_EACH_ENTRY( object, &metal_shared_objects, struct metal_shared_object, entry )
+    {
+        if (object->dev != st.st_dev || object->ino != st.st_ino) continue;
+        *type = object->type;
+        *handle = object->handle;
+        return TRUE;
+    }
+    WARN( "no Metal object for inode %llu in this process\n", (unsigned long long)st.st_ino );
+    return FALSE;
+}
