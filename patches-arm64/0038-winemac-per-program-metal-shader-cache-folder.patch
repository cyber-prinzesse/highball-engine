+/***********************************************************************
+ *              set_metal_shader_cache_path
+ *
+ * Metal keeps its shader cache (compiled MSL libraries and GPU pipeline binaries) in
+ * one folder per process identity, here the loader's, shared by every program this
+ * engine runs, and it takes another folder only before the first Metal device exists.
+ * Give each program its own folder under the user's cache folder, named after its
+ * executable, before the Cocoa side creates a device for the displays, so one game's
+ * pipelines survive the others' and a second start compiles nothing again.
+ * HB_METAL_SHADER_CACHE names another folder (a relative one goes under the user's
+ * cache folder) and 0 keeps Metal's default.
+ */
+static void set_metal_shader_cache_path(void)
+{
+    void (*set_path)(CFStringRef) = dlsym(RTLD_DEFAULT, "MTLSetShaderCachePath");
+    const char *env = getenv("HB_METAL_SHADER_CACHE");
+    char base[PATH_MAX], path[PATH_MAX], *p;
+    CFStringRef str;
+    size_t len;
+
+    if (!set_path || (env && !strcmp(env, "0"))) return;
+    if (env && env[0] == '/') snprintf(path, sizeof(path), "%s", env);
+    else
+    {
+        len = confstr(_CS_DARWIN_USER_CACHE_DIR, base, sizeof(base));
+        if (!len || len >= sizeof(base)) return;
+        if (len >= 2 && base[len - 2] == '/') base[len - 2] = 0;
+        if (env) snprintf(path, sizeof(path), "%s/%s", base, env);
+        else snprintf(path, sizeof(path), "%s/highball/%s/com.apple.metal", base, getprogname());
+    }
+    for (p = path + 1; *p; p++)
+        if (*p == '/') { *p = 0; mkdir(path, 0755); *p = '/'; }
+    mkdir(path, 0755);
+    if (!(str = CFStringCreateWithCString(NULL, path, kCFStringEncodingUTF8))) return;
+    set_path(str);
+    CFRelease(str);
+    TRACE("Metal shader cache folder %s\n", path);
 }
 
 
