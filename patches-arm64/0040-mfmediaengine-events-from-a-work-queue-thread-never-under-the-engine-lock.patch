+    struct list entry;
+    DWORD event;
+    DWORD_PTR param1;
+    DWORD param2;
+};
+
+static struct media_engine *impl_from_notify_IMFAsyncCallback(IMFAsyncCallback *iface)
+{
+    return CONTAINING_RECORD(iface, struct media_engine, notify_callback);
+}
+
+static ULONG WINAPI media_engine_notify_AddRef(IMFAsyncCallback *iface)
+{
+    struct media_engine *engine = impl_from_notify_IMFAsyncCallback(iface);
+    return IMFMediaEngineEx_AddRef(&engine->IMFMediaEngineEx_iface);
+}
+
+static ULONG WINAPI media_engine_notify_Release(IMFAsyncCallback *iface)
+{
+    struct media_engine *engine = impl_from_notify_IMFAsyncCallback(iface);
+    return IMFMediaEngineEx_Release(&engine->IMFMediaEngineEx_iface);
+}
+
+/* The dispatcher: delivers the queued events in order, on this work-queue thread, with no engine lock held. */
+static HRESULT WINAPI media_engine_notify_Invoke(IMFAsyncCallback *iface, IMFAsyncResult *result)
+{
+    struct media_engine *engine = impl_from_notify_IMFAsyncCallback(iface);
+    struct notify_event *e;
+    struct list *head;
+
+    engine->notify_thread = GetCurrentThreadId();
+    for (;;)
+    {
+        EnterCriticalSection(&engine->notify_cs);
+        if (!(head = list_head(&engine->notify_events)))
+        {
+            engine->notify_running = FALSE;
+            engine->notify_thread = 0;
+            SetEvent(engine->notify_idle);
+            LeaveCriticalSection(&engine->notify_cs);
+            break;
+        }
+        list_remove(head);
+        LeaveCriticalSection(&engine->notify_cs);
+
+        e = LIST_ENTRY(head, struct notify_event, entry);
+        IMFMediaEngineNotify_EventNotify(engine->callback, e->event, e->param1, e->param2);
+        free(e);
+    }
+
+    IMFMediaEngineEx_Release(&engine->IMFMediaEngineEx_iface);
+    return S_OK;
+}
+
+static const IMFAsyncCallbackVtbl media_engine_notify_vtbl =
+{
+    media_engine_callback_QueryInterface,
+    media_engine_notify_AddRef,
+    media_engine_notify_Release,
+    media_engine_callback_GetParameters,
+    media_engine_notify_Invoke,
+};
+
+/* Queue an event for the application. Called with engine->cs held; the callback runs later, without it. */
+static void media_engine_notify(struct media_engine *engine, DWORD event, DWORD_PTR param1, DWORD param2)
+{
+    struct notify_event *e;
+    BOOL schedule = FALSE;
+    HRESULT hr;
+
+    if (engine->flags & FLAGS_ENGINE_SHUT_DOWN)
+        return;
+    if (!(e = malloc(sizeof(*e))))
+        return;
+    e->event = event;
+    e->param1 = param1;
+    e->param2 = param2;
+
+    EnterCriticalSection(&engine->notify_cs);
+    list_add_tail(&engine->notify_events, &e->entry);
+    if (!engine->notify_running)
+    {
+        engine->notify_running = TRUE;
+        ResetEvent(engine->notify_idle);
+        schedule = TRUE;
+    }
+    LeaveCriticalSection(&engine->notify_cs);
+
+    if (!schedule)
+        return;
+
+    IMFMediaEngineEx_AddRef(&engine->IMFMediaEngineEx_iface);
+    if (FAILED(hr = MFPutWorkItem(MFASYNC_CALLBACK_QUEUE_MULTITHREADED, &engine->notify_callback, NULL)))
+    {
+        WARN("Failed to queue the notification, hr %#lx.\n", hr);
+        EnterCriticalSection(&engine->notify_cs);
+        engine->notify_running = FALSE;
+        SetEvent(engine->notify_idle);
+        LeaveCriticalSection(&engine->notify_cs);
+        IMFMediaEngineEx_Release(&engine->IMFMediaEngineEx_iface);
+    }
 }
 
+/* Wait for the queued events to be delivered. Called without engine->cs; a no-op on the dispatcher's own thread. */
+static void media_engine_notify_drain(struct media_engine *engine)
+{
+    unsigned int i;
+
+    if (GetCurrentThreadId() == engine->notify_thread)
+        return;
+    for (i = 0; i < 200; ++i)
+    {
+        BOOL running;
+
+        EnterCriticalSection(&engine->notify_cs);
+        running = engine->notify_running;
+        LeaveCriticalSection(&engine->notify_cs);
+        if (!running)
+            return;
+        WaitForSingleObject(engine->notify_idle, 50);
+    }
+    WARN("Notifications still pending after 10 s.\n");
+}
