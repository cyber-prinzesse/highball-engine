+/* Highball: a page the emulator made read-execute to see writes into translated code reads back with the protection
+ * the program set itself, as on Windows, where no such step exists */
+NTSTATUS SYSCALL_API NtQueryVirtualMemory( HANDLE process, LPCVOID addr, MEMORY_INFORMATION_CLASS info_class,
+                                           PVOID buffer, SIZE_T len, SIZE_T *res_len )
+{
+    NTSTATUS status;
+
+    if (!enter_syscall_callback())
+        return syscall_NtQueryVirtualMemory( process, addr, info_class, buffer, len, res_len );
+
+    status = syscall_NtQueryVirtualMemory( process, addr, info_class, buffer, len, res_len );
+    if (!status && info_class == MemoryBasicInformation && len >= sizeof(MEMORY_BASIC_INFORMATION) &&
+        pGuestProtection && RtlIsCurrentProcess( process ))
+    {
+        MEMORY_BASIC_INFORMATION *info = buffer;
+        if (info->State == MEM_COMMIT) info->Protect = pGuestProtection( info->BaseAddress, info->Protect );
+    }
+    leave_syscall_callback();
+    return status;
+}
+
