@@ -872,6 +874,10 @@
     else if (pNotifyMemoryProtect) pNotifyMemoryProtect( *addr_ptr, *size_ptr, new_prot, FALSE, 0 );
 
     status = syscall_NtProtectVirtualMemory( process, addr_ptr, size_ptr, new_prot, old_prot );
+
+    /* Highball: the emulator may have made the page read-execute to see writes into translated code; the program
+     * gets back the protection it set itself (asked before the notification below updates what the emulator knows) */
+    if (!status && is_current && old_prot && pGuestProtection) *old_prot = pGuestProtection( *addr_ptr, *old_prot );
 
     if (!is_current) send_cross_process_notification( process, CrossProcessPostVirtualProtect,
