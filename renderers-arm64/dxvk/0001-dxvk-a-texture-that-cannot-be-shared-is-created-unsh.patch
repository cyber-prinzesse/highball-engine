From b95ab6d8dfa85ec34a30e245e451e56f9becba67 Mon Sep 17 00:00:00 2001
From: Gauthier Piarrette <gauthierpiarrette@gmail.com>
Date: Mon, 12 Oct 2026 14:40:04 +0200
Subject: [PATCH 1/3] dxvk: a texture that cannot be shared is created unshared
 instead of calling a missing function

On MoltenVK (no VK_KHR_external_memory_win32) DxvkImage::allocateStorageWithUsage still set the allocation's export
handle type after canShareImage refused, and initKmtHandles then called vkGetMemoryWin32HandleKHR, which was never
loaded. Microsoft Flight Simulator 2024 crashed at its first boot video, where its Media Engine creates a shared D3D11
texture. The texture is now created unshared, and the game gets an error when it asks for the handle.
---
 src/dxvk/dxvk_image.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/dxvk/dxvk_image.cpp b/src/dxvk/dxvk_image.cpp
index 3b5b739..5ec2e4c 100644
--- a/src/dxvk/dxvk_image.cpp
+++ b/src/dxvk/dxvk_image.cpp
@@ -334,7 +334,7 @@ namespace dxvk {
     allocationInfo.resourceCookie = cookie();
     allocationInfo.properties = m_properties;
     allocationInfo.mode = mode;
-    allocationInfo.handleType = m_info.sharing.type;
+    allocationInfo.handleType = m_shared ? m_info.sharing.type : VK_EXTERNAL_MEMORY_HANDLE_TYPE_FLAG_BITS_MAX_ENUM;
 
     if (m_info.transient)
       allocationInfo.mode.set(DxvkAllocationMode::NoDedicated);
